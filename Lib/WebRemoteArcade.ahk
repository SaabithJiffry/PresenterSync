    js .= 'let hitP=false;for(const p of pylons){if(p.alive&&Math.hypot(m.x-p.x,m.y-p.y)<=p.r+m.r){p.alive=false;hitP=true;burst(p.x,p.y,"#ef4444",12);pops.push({x:p.x,y:p.y-20,t:"PYLON LOST!",l:0.9,m:0.9,c:"#ef4444"});break;}}'
    js .= 'if(hitP||m.y>=H-18||m.x<-24||m.x>W+24){if(hitP){combo=0;syncHud();if(aliveCnt()===0){phase="gameover";PSArcadeHost.showCard("GAME OVER","Wave "+wave+" | Score "+score+" (Best "+hi+")","Play Again (R)");}}meteors.splice(i,1);}}'
    js .= 'if(phase==="playing"&&wavePend<=0&&meteors.length===0&&waveDelay<=0){const al=aliveCnt(),bn=al*100;if(bn>0)addScore(bn,W*0.5,H*0.35,"#38bdf8","WAVE "+wave+" CLEAR +"+bn);'
    js .= 'if(wave%3===0&&al<pylons.length){const d=pylons.find(p=>!p.alive);if(d){d.alive=true;pops.push({x:d.x,y:d.y-20,t:"PYLON RESTORED!",l:1,m:1,c:"#10b981"});}}wave++;waveDelay=1.2;syncHud();}'
    js .= 'parts=parts.filter(p=>{p.x+=p.vx*dt;p.y+=p.vy*dt;p.l-=dt;return p.l>0;});pops=pops.filter(pp=>{pp.y-=26*dt;pp.l-=dt;return pp.l>0;});}'
    js .= 'function draw(){ctx.clearRect(0,0,W,H);'
    js .= 'ctx.strokeStyle="rgba(56,189,248,0.4)";ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(14,H-16);ctx.lineTo(W-14,H-16);ctx.stroke();'
    js .= 'pylons.forEach(p=>{if(p.alive){ctx.fillStyle="rgba(14,165,233,0.8)";ctx.strokeStyle="#7dd3fc";ctx.lineWidth=1.8;ctx.beginPath();ctx.roundRect(p.x-18,p.y-9,36,18,5);ctx.fill();ctx.stroke();}else{ctx.fillStyle="rgba(239,68,68,0.35)";ctx.beginPath();ctx.roundRect(p.x-16,p.y+2,32,7,3);ctx.fill();}});'
    js .= 'ctx.fillStyle="rgba(16,185,129,0.82)";ctx.strokeStyle="#6ee7b7";ctx.lineWidth=1.8;ctx.beginPath();ctx.roundRect(W*0.5-14,H-36,28,20,7);ctx.fill();ctx.stroke();'
