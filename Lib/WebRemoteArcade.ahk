    js .= 'pylons=[0.16,0.34,0.66,0.84].map(r=>({x:W*r,y:H-30,alive:true,r:20}));'
    js .= 'meteors=[];ints=[];blasts=[];parts=[];pops=[];startWave(1);phase="playing";PSArcadeHost.hideCard();syncHud();}'
    js .= 'function pickOrigin(tx){let bx=W*0.5,by=H-26,bd=Math.abs(tx-bx);pylons.forEach(p=>{if(p.alive){const d=Math.abs(tx-p.x);if(d<bd){bd=d;bx=p.x;by=p.y-8;}}});return{x:bx,y:by};}'
    js .= 'function fire(tx,ty){if(phase!=="playing")return;const cx=Math.max(18,Math.min(W-18,tx)),cy=Math.max(40,Math.min(H-50,ty));'
    js .= 'const o=pickOrigin(cx),dx=cx-o.x,dy=cy-o.y,dist=Math.max(1,Math.hypot(dx,dy)),spd=660;'
    js .= 'ints.push({sx:o.x,sy:o.y,x:o.x,y:o.y,tx:cx,ty:cy,vx:(dx/dist)*spd,vy:(dy/dist)*spd,spd});}'
    js .= 'function spawnMeteor(){const sx=32+Math.random()*Math.max(40,W-64),sy=20;'
    js .= 'const al=pylons.filter(p=>p.alive);const tx=(al.length?al[Math.floor(Math.random()*al.length)].x:W*0.5)+(Math.random()-0.5)*44,ty=H-30;'
    js .= 'const dx=tx-sx,dy=Math.max(50,ty-sy),dist=Math.max(1,Math.hypot(dx,dy)),spd=72+wave*13+Math.random()*22;'
    js .= 'const sp=wave>=2&&Math.random()<Math.min(0.4,0.14+wave*0.04);'
    js .= 'meteors.push({x:sx,y:sy,vx:(dx/dist)*spd,vy:(dy/dist)*spd,r:sp?8.5:6.5,sp,splitDone:false,splitY:H*(0.3+Math.random()*0.18),tr:[]});}'
    js .= 'function step(dt){if(phase!=="playing")return;'
    js .= 'if(comboT>0){comboT-=dt;if(comboT<=0){combo=0;syncHud();}}'
    js .= 'let ix=(keys.right?1:0)-(keys.left?1:0),iy=(keys.down?1:0)-(keys.up?1:0);'
    js .= 'if(ix||iy){if(ix&&iy){ix*=0.7071;iy*=0.7071;}ret.x=Math.max(18,Math.min(W-18,ret.x+ix*400*dt));ret.y=Math.max(40,Math.min(H-50,ret.y+iy*400*dt));}'
    js .= 'if(waveDelay>0){waveDelay-=dt;if(waveDelay<=0)startWave(wave);}'
