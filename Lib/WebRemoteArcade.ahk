; ==============================================================================
; Module: WebRemoteArcade.ahk
; Description: Confidential Sector Z RAM-only Master Arcade Vault and HTML5
;              Canvas2D arcade suite served on GET /arcade.js by HostBridge.ahk.
; ==============================================================================

#Requires AutoHotkey v2.0

BuildWebRemoteArcadeJs() {
    js := '(()=>{ "use strict";'
    js .= 'if(window.PSArcadeVault)return;'
    js .= 'const qs=id=>document.getElementById(id);'

    ; 1. Subtle DevTools console Sector Z banner (never prints passcode)
    js .= 'try{console.log("%c  ____  _____ ____ _____ ___  ____    _____ \n / ___|| ____/ ___|_   _/ _ \\|  _ \\  |__  / \n \\___ \\|  _|| |     | || | | | |_) |   / /  \n  ___) | |__| |___  | || |_| |  _ <   / /_  \n |____/|_____\\____| |_| \\___/|_| \\_\\ /____| \n%c[SECTOR Z // CABINET STANDBY: 0 CREDITS]","color:#38bdf8;font-weight:700","color:#94a3b8;font-family:monospace");}catch(_){}'

    ; 2. Inject crisp dark-glass Sector Z + Arcade Host CSS once
    js .= 'const st=document.createElement("style");'
    js .= 'st.textContent='
    js .= '".arcOverlay{position:fixed;inset:0;z-index:9999;background:rgba(7,11,20,0.82);backdrop-filter:blur(7px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:12px;user-select:none;touch-action:none}"'
    js .= '+".arcHud{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:center;background:rgba(19,23,34,0.92);border:1px solid rgba(255,255,255,0.16);border-radius:999px;padding:6px 14px;font-size:12px;box-shadow:0 8px 28px rgba(0,0,0,.5);color:#f1f5f9}"'
    js .= '+".arcBadge{font-weight:800;letter-spacing:.6px;color:#38bdf8}"'
    js .= '+".arcMicBadge{font-size:10.5px;font-weight:800;padding:3px 9px;border-radius:999px;color:#fff;letter-spacing:.4px}"'
    js .= '+".arcMicBadge.live{background:#107c10}.arcMicBadge.muted{background:#c42b1c}"'
    js .= '+".arcCanvas{border-radius:14px;background:rgba(10,15,26,0.72);border:1px solid rgba(148,163,184,0.22);box-shadow:0 16px 48px rgba(0,0,0,.6);max-width:100%;max-height:76vh}"'
    js .= '+".arcCard{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);min-width:260px;max-width:90vw;background:rgba(15,23,42,0.96);border:1px solid rgba(56,189,248,.35);border-radius:16px;padding:18px;text-align:center;box-shadow:0 18px 50px rgba(0,0,0,.7);display:flex;flex-direction:column;gap:10px;z-index:10002;color:#f1f5f9}"'
    js .= '+".arcDpad{display:grid;grid-template-columns:repeat(3,48px);grid-template-rows:repeat(2,44px);gap:6px;margin-top:4px}"'
    js .= '+".arcDpad button{padding:0;font-size:16px;border-radius:10px;background:rgba(30,36,51,.9);color:#f1f5f9}"'
    js .= '+".arcTermBg{position:fixed;inset:0;z-index:10010;background:rgba(4,6,12,.85);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:16px}"'
    js .= '+".arcTermCard{width:100%;max-width:390px;background:#070b14;border:1.5px solid #38bdf8;border-radius:14px;padding:18px;box-shadow:0 20px 56px rgba(0,0,0,.8);display:flex;flex-direction:column;gap:11px;font-family:ui-monospace,Consolas,monospace;color:#e2e8f0}"'
    js .= '+".arcToast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);z-index:10020;background:#0f172a;border:1px solid #38bdf8;color:#e2e8f0;font-family:ui-monospace,Consolas,monospace;font-size:12px;padding:8px 14px;border-radius:10px;box-shadow:0 10px 28px rgba(0,0,0,.6)}"'
    js .= '+".vaultDrawer{margin-top:8px;padding:12px;background:#090d16;border:1px solid #10b981;border-radius:12px;display:flex;flex-direction:column;gap:8px}"'
    js .= '+".vaultGameRow{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:12px;background:#111827;padding:8px 10px;border-radius:9px;border:1px solid #1f2937}";'
    js .= 'document.head.appendChild(st);'

    ; 3. Transient Toast helper
    js .= 'let toastTimer=null;'
    js .= 'function showToast(msg){let el=qs("arcToastEl");if(!el){el=document.createElement("div");el.id="arcToastEl";el.className="arcToast";document.body.appendChild(el);}el.textContent=msg;el.classList.remove("hide");clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.add("hide"),3200);}'

    ; 4. Shared RAM-Only Master Arcade Vault (`INSERTCOIN`)
    js .= 'const PASS_NORM="INSERTCOIN";'
    js .= 'const CLUES=['
    js .= '"SECTOR Z // CLEARANCE REQUIRED - Cabinet Bus at 0 Credits.",'
    js .= '"Konami impulse or 7-pulse build telemetry opens the coin slot.",'
    js .= '"Classic twin-word coin-op start legend waits inside the terminal.",'
    js .= '"Desktop chord Ctrl+Alt+Shift+Z activates the local terminal bridge."'
    js .= '];'
    js .= 'let unlocked=false,clueIdx=0,aboutTaps=0,aboutTapTimer=null;'
    js .= 'const konamiSeq=["arrowup","arrowup","arrowdown","arrowdown","arrowleft","arrowright","arrowleft","arrowright"];'
    js .= 'let konamiPos=0;'
    js .= 'function normCode(s){return String(s||"").toUpperCase().replace(/[^A-Z0-9]/g,"");}'
    js .= 'function nextClue(){const c=CLUES[clueIdx%CLUES.length];clueIdx=(clueIdx+1)%CLUES.length;return c;}'

    ; 5. Build Shared Arcade Host Overlay DOM
    js .= 'const wrap=document.createElement("div");wrap.id="arcWrap";wrap.className="arcOverlay hide";wrap.setAttribute("role","dialog");wrap.setAttribute("aria-label","Arcade Overlay");'
    js .= 'wrap.innerHTML='
    js .= '"<div class=\"arcHud\">"'
    js .= '+"<b id=\"arcGameTitle\" class=\"arcBadge\">ARCADE</b>"'
    js .= '+"<span id=\"arcMicBadge\" class=\"arcMicBadge live\">MIC LIVE</span>"'
    js .= '+"<span>SCORE <b id=\"arcScore\">0</b></span>"'
    js .= '+"<span>BEST <b id=\"arcBest\">0</b></span>"'
    js .= '+"<span id=\"arcExtraStat\"></span>"'
    js .= '+"<button id=\"arcModeBtn\" type=\"button\" class=\"sm hide\"></button>"'
    js .= '+"<button id=\"arcPauseBtn\" type=\"button\" class=\"sm\">Pause (P)</button>"'
    js .= '+"<button id=\"arcPadBtn\" type=\"button\" class=\"sm hide\">D-Pad</button>"'
    js .= '+"<button id=\"arcExitBtn\" type=\"button\" class=\"sm dng\">Exit (Esc)</button>"'
    js .= '+"</div>"'
    js .= '+"<canvas id=\"arcCanvas\" class=\"arcCanvas\"></canvas>"'
    js .= '+"<div id=\"arcDpad\" class=\"arcDpad hide\">"'
    js .= '+"<div></div><button type=\"button\" data-adir=\"0,-1\">&#9650;</button><div></div>"'
    js .= '+"<button type=\"button\" data-adir=\"-1,0\">&#9664;</button><button type=\"button\" data-adir=\"0,1\">&#9660;</button><button type=\"button\" data-adir=\"1,0\">&#9654;</button>"'
    js .= '+"</div>"'
    js .= '+"<div id=\"arcCard\" class=\"arcCard hide\">"'
    js .= '+"<div id=\"arcCardTitle\" style=\"font-size:18px;font-weight:800\">PAUSED</div>"'
    js .= '+"<div id=\"arcCardSub\" style=\"font-size:12.5px;color:#94a3b8\">Press Space or tap Resume</div>"'
    js .= '+"<div class=\"row\" style=\"justify-content:center\">"'
    js .= '+"<button id=\"arcCardAct\" type=\"button\" class=\"act grow\">Resume</button>"'
    js .= '+"<button id=\"arcCardExit\" type=\"button\" class=\"dng\">Exit</button>"'
    js .= '+"</div></div>";'
    js .= 'document.body.appendChild(wrap);'

    js .= 'const cvs=qs("arcCanvas"),ctx=cvs.getContext("2d");'
    js .= 'let activeMod=null,micMuted=false,rafId=0,lastTickMs=0;'

    js .= 'const PSArcadeHost={'
    js .= 'setMicMuted:m=>{micMuted=!!m;const b=qs("arcMicBadge");if(b){b.textContent=micMuted?"MIC MUTED":"MIC LIVE";b.className="arcMicBadge "+(micMuted?"muted":"live");}},'
    js .= 'isMicMuted:()=>micMuted,'
    js .= 'setHud:(score,best,extraHtml,modeLabel,pauseLabel,showPad)=>{'
    js .= 'qs("arcScore").textContent=String(score);qs("arcBest").textContent=String(best);'
    js .= 'qs("arcExtraStat").textContent=extraHtml||"";'
    js .= 'const mb=qs("arcModeBtn");if(modeLabel){mb.textContent=modeLabel;mb.classList.remove("hide");}else{mb.classList.add("hide");}'
    js .= 'qs("arcPauseBtn").textContent=pauseLabel||"Pause (P)";'
    js .= 'qs("arcPadBtn").classList.toggle("hide",!showPad);'
    js .= '},'
    js .= 'showCard:(t,sub,btn)=>{qs("arcCardTitle").textContent=t;qs("arcCardSub").textContent=sub;qs("arcCardAct").textContent=btn;qs("arcCard").classList.remove("hide");},'
    js .= 'hideCard:()=>qs("arcCard").classList.add("hide"),'
    js .= 'canvas:cvs,ctx:ctx,dpad:qs("arcDpad"),'
    js .= 'launch:mod=>{if(!unlocked){showToast(nextClue());openTerminal();return false;}stopActive();activeMod=mod;wrap.classList.remove("hide");qs("arcCard").classList.add("hide");qs("arcGameTitle").textContent=mod.title;lastTickMs=performance.now();mod.init();rafId=requestAnimationFrame(hostLoop);return true;},'
    js .= 'stop:stopActive,'
    js .= 'isActive:()=>activeMod!==null'
    js .= '};'

    js .= 'function stopActive(){if(rafId){cancelAnimationFrame(rafId);rafId=0;}if(activeMod&&activeMod.destroy)activeMod.destroy();activeMod=null;wrap.classList.add("hide");qs("arcCard").classList.add("hide");qs("arcDpad").classList.add("hide");}'
    js .= 'function hostLoop(now){if(!activeMod)return;const dt=Math.min(0.05,Math.max(0.001,(now-lastTickMs)/1000));lastTickMs=now;activeMod.frame(now,dt);rafId=requestAnimationFrame(hostLoop);}'
    js .= 'qs("arcModeBtn").addEventListener("click",()=>{if(activeMod&&activeMod.onMode)activeMod.onMode();});'
    js .= 'qs("arcPauseBtn").addEventListener("click",()=>{if(activeMod&&activeMod.onPause)activeMod.onPause();});'
    js .= 'qs("arcPadBtn").addEventListener("click",()=>qs("arcDpad").classList.toggle("hide"));'
    js .= 'qs("arcExitBtn").addEventListener("click",stopActive);'
    js .= 'qs("arcCardExit").addEventListener("click",stopActive);'
    js .= 'qs("arcCardAct").addEventListener("click",()=>{if(activeMod&&activeMod.onCardAction)activeMod.onCardAction();});'
    js .= 'document.querySelectorAll("[data-adir]").forEach(b=>b.addEventListener("click",()=>{if(activeMod&&activeMod.onDpad){const[dx,dy]=b.dataset.adir.split(",").map(Number);activeMod.onDpad(dx,dy);}}));'
    js .= 'window.addEventListener("resize",()=>{if(activeMod&&activeMod.onResize)activeMod.onResize();});'

    ; 6. Web Game #1: HUD Snake (migrated & vault-gated)
    js .= 'const PSWebSnake=(()=>{const cols=24,rows=18;let cell=20,phase="idle",snake=[],prevSnake=[],dir={x:-1,y:0},q=[],grow=0,score=0,eaten=0,wrapMode=false,stepMs=132,stepStart=0,frozen=0,food=null,pops=[],touch0=null;'
    js .= 'let hi=parseInt(localStorage.getItem("ps_arcade_hi_snake")||"0",10)||0;'
    js .= 'function size(){const mw=Math.min(640,window.innerWidth-28),mh=Math.min(460,window.innerHeight-180);cell=Math.max(14,Math.min(26,Math.floor(Math.min(mw/cols,mh/rows))));cvs.width=cols*cell;cvs.height=rows*cell;}'
    js .= 'function clone(a){return a.map(p=>({col:p.col,row:p.row}));}'
    js .= 'function spawnFood(kind){const used=new Set(snake.map(s=>s.col+","+s.row));const free=[];for(let c=0;c<cols;c++)for(let r=0;r<rows;r++)if(!used.has(c+","+r))free.push({c,r});if(!free.length)return;const pick=free[Math.floor(Math.random()*free.length)];const isB=(kind==="bonus");food={col:pick.c,row:pick.r,kind:kind||"normal",born:performance.now(),ttl:isB?7000:0,pts:isB?30:10};}'
    js .= 'function syncHud(){PSArcadeHost.setHud(score,hi,"LEN "+snake.length,(wrapMode?"WRAP":"WALLS")+" (E)",phase==="paused"?"Resume (P)":"Pause (P)",true);}'
    js .= 'function reset(){size();const mx=Math.floor(cols/2),my=Math.floor(rows/2);snake=[{col:mx,row:my},{col:mx+1,row:my},{col:mx+2,row:my},{col:mx+3,row:my}];prevSnake=clone(snake);dir={x:-1,y:0};q=[];grow=0;score=0;eaten=0;stepMs=132;frozen=0;pops=[];phase="playing";PSArcadeHost.hideCard();spawnFood("normal");stepStart=performance.now();syncHud();}'
    js .= 'function queueDir(nx,ny){if(phase!=="playing")return;const last=q.length?q[q.length-1]:dir;if((nx===-last.x&&ny===-last.y)||(nx===last.x&&ny===last.y))return;if(q.length<2)q.push({x:nx,y:ny});}'
    js .= 'function gameOver(reason){phase="gameover";prevSnake=clone(snake);frozen=0.32;PSArcadeHost.showCard("GAME OVER",reason+" | Score "+score+" (Best "+hi+")","Retry (R)");syncHud();}'
    js .= 'function step(now){if(food&&food.ttl>0&&(now-food.born)>=food.ttl)spawnFood("normal");if(q.length)dir=q.shift();let nc=snake[0].col+dir.x,nr=snake[0].row+dir.y;'
    js .= 'if(nc<0||nc>=cols||nr<0||nr>=rows){if(wrapMode){nc=(nc+cols)%cols;nr=(nr+rows)%rows;}else{gameOver("Hit Arena Wall");return;}}'
    js .= 'const eat=food&&nc===food.col&&nr===food.row;const lim=(grow===0&&!eat)?snake.length-1:snake.length;'
    js .= 'for(let i=0;i<lim;i++){if(snake[i].col===nc&&snake[i].row===nr){gameOver("Self Collision");return;}}'
    js .= 'prevSnake=clone(snake);if(eat){score+=food.pts;eaten++;grow+=(food.kind==="bonus"?2:1);if(score>hi){hi=score;localStorage.setItem("ps_arcade_hi_snake",String(hi));}pops.push({x:(nc+0.5)*cell,y:(nr+0.5)*cell,t:"+"+food.pts,b:now,c:food.kind==="bonus"?"#fbbf24":"#6ee7b7"});stepMs=Math.max(68,132-Math.min(64,eaten*3));const nk=(eaten%5===0)?"bonus":"normal";food=null;snake.unshift({col:nc,row:nr});if(grow>0)grow--;else snake.pop();spawnFood(nk);syncHud();}else{snake.unshift({col:nc,row:nr});if(grow>0)grow--;else snake.pop();}}'
    js .= 'function draw(now){ctx.clearRect(0,0,cvs.width,cvs.height);const W=cvs.width,H=cvs.height;'
    js .= 'ctx.save();if(wrapMode){ctx.setLineDash([7,6]);ctx.strokeStyle="rgba(245,158,11,0.58)";ctx.lineWidth=2;ctx.strokeRect(2,2,W-4,H-4);}else{ctx.strokeStyle="rgba(148,163,184,0.34)";ctx.lineWidth=2;ctx.strokeRect(2,2,W-4,H-4);const L=12;ctx.strokeStyle="#34d399";[[2,2,1,1],[W-2,2,-1,1],[2,H-2,1,-1],[W-2,H-2,-1,-1]].forEach(([bx,by,sx,sy])=>{ctx.beginPath();ctx.moveTo(bx+sx*L,by);ctx.lineTo(bx,by);ctx.lineTo(bx,by+sy*L);ctx.stroke();});}ctx.restore();'
    js .= 'if(food){const fx=(food.col+0.5)*cell,fy=(food.row+0.5)*cell,r=cell*0.34;ctx.save();if(food.kind==="bonus"){const rem=Math.max(0,1-(now-food.born)/food.ttl);ctx.fillStyle="#f59e0b";ctx.shadowColor="rgba(245,158,11,.65)";ctx.shadowBlur=10;ctx.beginPath();for(let k=0;k<8;k++){const rad=(k%2===0)?r*1.15:r*0.52;const ang=k*Math.PI/4-Math.PI/2;ctx.lineTo(fx+Math.cos(ang)*rad,fy+Math.sin(ang)*rad);}ctx.closePath();ctx.fill();ctx.shadowBlur=0;ctx.strokeStyle="#fde68a";ctx.lineWidth=2;ctx.beginPath();ctx.arc(fx,fy,r*1.38,-Math.PI/2,-Math.PI/2+Math.PI*2*rem);ctx.stroke();}else{ctx.fillStyle="#ef4444";ctx.shadowColor="rgba(239,68,68,.55)";ctx.shadowBlur=8;const s=r*1.6;ctx.beginPath();ctx.roundRect(fx-s/2,fy-s/2,s,s,r*0.45);ctx.fill();}ctx.restore();}'
    js .= 'const t=phase==="playing"?Math.min(1,(now-stepStart)/stepMs):(phase==="gameover"?frozen:0);'
    js .= 'const pts=snake.map((s,i)=>{const p=prevSnake[i]||s;let dx=s.col-p.col,dy=s.row-p.row;if(Math.abs(dx)>1.5||Math.abs(dy)>1.5){dx=0;dy=0;}return{x:(p.col+dx*t+0.5)*cell,y:(p.row+dy*t+0.5)*cell,col:s.col,row:s.row};});'
    js .= 'const segs=[];let cur=[];pts.forEach((p,i)=>{if(i>0&&(Math.abs(p.col-pts[i-1].col)>1.5||Math.abs(p.row-pts[i-1].row)>1.5)){segs.push(cur);cur=[];}cur.push(p);});if(cur.length)segs.push(cur);'
    js .= 'ctx.save();ctx.lineCap="round";ctx.lineJoin="round";segs.forEach(sg=>{if(sg.length<1)return;ctx.strokeStyle="rgba(16,185,129,0.28)";ctx.lineWidth=cell*0.86;ctx.beginPath();sg.forEach((p,idx)=>idx?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));ctx.stroke();ctx.strokeStyle=phase==="gameover"?"#f87171":"#10b981";ctx.lineWidth=cell*0.66;ctx.stroke();ctx.strokeStyle="rgba(255,255,255,0.22)";ctx.lineWidth=cell*0.22;ctx.stroke();});ctx.restore();'
    js .= 'if(pts.length){const h=pts[0];const ox=dir.x*cell*0.12,oy=dir.y*cell*0.12,px=-dir.y*cell*0.16,py=dir.x*cell*0.16;[1,-1].forEach(sd=>{ctx.fillStyle="#fff";ctx.beginPath();ctx.arc(h.x+ox+px*sd,h.y+oy+py*sd,cell*0.12,0,Math.PI*2);ctx.fill();ctx.fillStyle="#0f172a";ctx.beginPath();ctx.arc(h.x+ox*1.3+px*sd,h.y+oy*1.3+py*sd,cell*0.06,0,Math.PI*2);ctx.fill();});}'
    js .= 'pops=pops.filter(pp=>now-pp.b<700);pops.forEach(pp=>{const a=1-(now-pp.b)/700;ctx.fillStyle=pp.c;ctx.globalAlpha=a;ctx.font="bold "+Math.round(cell*0.58)+"px system-ui";ctx.textAlign="center";ctx.fillText(pp.t,pp.x,pp.y-18*(1-a));ctx.globalAlpha=1;});}'
    js .= 'function onTouchStart(e){if(e.touches.length)touch0={x:e.touches[0].clientX,y:e.touches[0].clientY};}'
    js .= 'function onTouchMove(e){if(!touch0||!e.touches.length)return;const dx=e.touches[0].clientX-touch0.x,dy=e.touches[0].clientY-touch0.y;if(Math.abs(dx)<20&&Math.abs(dy)<20)return;if(Math.abs(dx)>Math.abs(dy))queueDir(dx>0?1:-1,0);else queueDir(0,dy>0?1:-1);touch0={x:e.touches[0].clientX,y:e.touches[0].clientY};}'
    js .= 'function togglePause(){if(phase==="playing"){phase="paused";PSArcadeHost.showCard("PAUSED","Press Space/P or tap Resume","Resume");}else if(phase==="paused"){phase="playing";stepStart=performance.now();PSArcadeHost.hideCard();}syncHud();}'
    js .= 'const mod={id:"snake",title:"HUD SNAKE",'
    js .= 'init:()=>{if(window.matchMedia&&window.matchMedia("(pointer:coarse)").matches)qs("arcDpad").classList.remove("hide");cvs.addEventListener("touchstart",onTouchStart,{passive:true});cvs.addEventListener("touchmove",onTouchMove,{passive:true});reset();},'
    js .= 'destroy:()=>{phase="idle";cvs.removeEventListener("touchstart",onTouchStart);cvs.removeEventListener("touchmove",onTouchMove);},'
    js .= 'frame:(now)=>{if(phase==="playing"){while(now-stepStart>=stepMs){stepStart+=stepMs;step(now);if(phase!=="playing")break;}}draw(now);},'
    js .= 'onResize:size,onMode:()=>{wrapMode=!wrapMode;syncHud();},onPause:togglePause,'
    js .= 'onCardAction:()=>{if(phase==="gameover")reset();else togglePause();},'
    js .= 'onDpad:(dx,dy)=>queueDir(dx,dy),'
    js .= 'onKey:(e,isDown)=>{if(!isDown)return false;const k=e.key.toLowerCase();'
    js .= 'if(k==="escape"){e.preventDefault();stopActive();return true;}'
    js .= 'if(k==="e"){e.preventDefault();wrapMode=!wrapMode;syncHud();return true;}'
    js .= 'if(k==="p"||(k===" "&&phase!=="gameover")){e.preventDefault();togglePause();return true;}'
    js .= 'if(k==="r"&&phase==="gameover"){e.preventDefault();reset();return true;}'
    js .= 'const mp={arrowup:[0,-1],w:[0,-1],arrowdown:[0,1],s:[0,1],arrowleft:[-1,0],a:[-1,0],arrowright:[1,0],d:[1,0]};'
    js .= 'if(mp[k]){e.preventDefault();queueDir(mp[k][0],mp[k][1]);return true;}return false;}};'
    js .= 'return{start:()=>PSArcadeHost.launch(mod),stop:()=>{if(activeMod===mod)stopActive();},toggle:()=>(activeMod===mod)?stopActive():PSArcadeHost.launch(mod),getBest:()=>hi};})();'

    ; 7. Web Game #2: Asteroid / Alien Blaster (`Ctrl+Alt+Shift+A`)
    js .= 'const PSWebAsteroids=(()=>{let W=640,H=460,phase="idle",score=0,wave=1,lives=3,ship={},rocks=[],bolts=[],saucer=null,powerUps=[],parts=[],pops=[],keys={},ptr={active:false,x:0,y:0},autoFire=false,saucerT=12,waveT=0;'
    js .= 'let hi=parseInt(localStorage.getItem("ps_arcade_hi_asteroids")||"0",10)||0;'
    js .= 'function bumperRect(){const w=116,h=28;return{l:W/2-w/2,t:H-54,r:W/2+w/2,b:H-54+h,cx:W/2,cy:H-54+h/2,rad:h/2};}'
    js .= 'function size(){W=Math.max(320,Math.min(760,window.innerWidth-28));H=Math.max(300,Math.min(540,window.innerHeight-180));cvs.width=W;cvs.height=H;}'
    js .= 'function syncHud(){let p="";if(ship.rapid>0)p+=" · RAPID";if(ship.spread>0)p+=" · SPREAD";if(ship.shield>0)p+=" · SHIELD";PSArcadeHost.setHud(score,hi,"W"+wave+" · ♥".repeat(Math.max(0,lives))+p,autoFire?"Auto: ON (F)":"Auto: OFF (F)",phase==="paused"?"Resume (P)":"Pause (P)",false);}'
    js .= 'function resetShip(){ship={x:W/2,y:H/2,vx:0,vy:0,ang:-Math.PI/2,r:13,inv:2.0,rapid:0,spread:0,shield:0,cd:0};}'
    js .= 'function spawnRock(x,y,vx,vy,sz){const r=sz===3?34:(sz===2?20:11);const verts=Array.from({length:10},()=>0.78+Math.random()*0.4);rocks.push({x,y,vx,vy,sz,r,ang:Math.random()*Math.PI*2,spin:(Math.random()-0.5)*2.2,verts});}'
    js .= 'function spawnWave(n){const cnt=Math.min(9,3+n);for(let i=0;i<cnt;i++){let rx=0,ry=0,tr=0;do{rx=Math.random()*W;ry=Math.random()*H;tr++;}while(tr<12&&Math.hypot(rx-ship.x,ry-ship.y)<120);const a=Math.random()*Math.PI*2,sp=52+n*8+Math.random()*36;spawnRock(rx,ry,Math.cos(a)*sp,Math.sin(a)*sp,3);}}'
    js .= 'function reset(){size();score=0;wave=1;lives=3;rocks=[];bolts=[];saucer=null;powerUps=[];parts=[];pops=[];saucerT=12;waveT=0;resetShip();phase="playing";PSArcadeHost.hideCard();spawnWave(wave);syncHud();}'
    js .= 'function burst(x,y,c,n){for(let i=0;i<n;i++){const a=Math.random()*Math.PI*2,s=45+Math.random()*115;parts.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,l:0.45,m:0.45,c});}}'
    js .= 'function addScore(pts,x,y,c){score+=pts;if(score>hi){hi=score;localStorage.setItem("ps_arcade_hi_asteroids",String(hi));}pops.push({x,y,t:"+"+pts,l:0.85,m:0.85,c});syncHud();}'
    js .= 'function fire(){if(phase!=="playing"||ship.cd>0)return;ship.cd=ship.rapid>0?0.11:0.22;const offs=ship.spread>0?[-0.18,0,0.18]:[0];offs.forEach(dAng=>{const a=ship.ang+dAng,ux=Math.cos(a),uy=Math.sin(a);bolts.push({x:ship.x+ux*16,y:ship.y+uy*16,vx:ship.vx*0.25+ux*480,vy:ship.vy*0.25+uy*480,ttl:1.2,ufo:false});});}'
    js .= 'function deflect(obj,rad){const b=bumperRect();const cx=Math.max(b.l,Math.min(b.r,obj.x)),cy=Math.max(b.t,Math.min(b.b,obj.y));const dx=obj.x-cx,dy=obj.y-cy,dist=Math.hypot(dx,dy);if(dist>=rad)return;const nx=dist>0.001?dx/dist:0,ny=dist>0.001?dy/dist:-1;const ov=rad-dist+2;obj.x+=nx*ov;obj.y+=ny*ov;const dot=obj.vx*nx+obj.vy*ny;if(dot<0){obj.vx-=1.9*dot*nx;obj.vy-=1.9*dot*ny;burst(cx,cy,"#34d399",4);}}'
    js .= 'function hitShip(){burst(ship.x,ship.y,"#ef4444",18);lives--;if(lives<=0){lives=0;phase="gameover";PSArcadeHost.showCard("GAME OVER","Wave "+wave+" | Score "+score+" (Best "+hi+")","Play Again (R)");}else{resetShip();}syncHud();}'
    js .= 'function destroyRock(idx){const r=rocks.splice(idx,1)[0];const pts=r.sz===3?20:(r.sz===2?50:100);addScore(pts,r.x,r.y,"#60cdff");burst(r.x,r.y,"#93c5fd",9);if(r.sz>1){for(let k=0;k<2;k++){const a=Math.random()*Math.PI*2,sp=72+wave*9+Math.random()*45;spawnRock(r.x,r.y,Math.cos(a)*sp,Math.sin(a)*sp,r.sz-1);}}else if(Math.random()<0.18){const ks=["RAPID","SPREAD","SHIELD"];powerUps.push({kind:ks[Math.floor(Math.random()*ks.length)],x:r.x,y:r.y,vx:(Math.random()-0.5)*28,vy:(Math.random()-0.5)*28,ttl:10});}}'
    js .= 'function step(dt){if(phase!=="playing")return;ship.inv=Math.max(0,ship.inv-dt);ship.rapid=Math.max(0,ship.rapid-dt);ship.spread=Math.max(0,ship.spread-dt);ship.shield=Math.max(0,ship.shield-dt);ship.cd=Math.max(0,ship.cd-dt);'
    js .= 'if(keys.left)ship.ang-=3.9*dt;if(keys.right)ship.ang+=3.9*dt;'
    js .= 'if(ptr.active){const dx=ptr.x-ship.x,dy=ptr.y-ship.y;if(Math.hypot(dx,dy)>14){ship.ang=Math.atan2(dy,dx);ship.vx+=Math.cos(ship.ang)*280*dt;ship.vy+=Math.sin(ship.ang)*280*dt;}}else if(keys.up){ship.vx+=Math.cos(ship.ang)*295*dt;ship.vy+=Math.sin(ship.ang)*295*dt;}'
    js .= 'const drag=Math.max(0.85,1-0.55*dt);ship.vx*=drag;ship.vy*=drag;const sp=Math.hypot(ship.vx,ship.vy);if(sp>340){ship.vx*=340/sp;ship.vy*=340/sp;}'
    js .= 'ship.x=(ship.x+ship.vx*dt+W)%W;ship.y=(ship.y+ship.vy*dt+H)%H;deflect(ship,ship.r);'
    js .= 'if(keys.fire||autoFire||ptr.active)fire();'
    js .= 'bolts=bolts.filter(b=>{b.x+=b.vx*dt;b.y+=b.vy*dt;b.ttl-=dt;return b.ttl>0&&b.x>-20&&b.x<W+20&&b.y>-20&&b.y<H+20;});'
    js .= 'rocks.forEach(r=>{r.x=(r.x+r.vx*dt+W)%W;r.y=(r.y+r.vy*dt+H)%H;r.ang+=r.spin*dt;deflect(r,r.r);});'
    js .= 'if(saucer){saucer.x+=saucer.vx*dt;saucer.y=(saucer.y+saucer.vy*dt+H)%H;saucer.fireT-=dt;if(saucer.fireT<=0){saucer.fireT=1.6;const aim=Math.atan2(ship.y-saucer.y,ship.x-saucer.x)+(Math.random()-0.5)*0.25;bolts.push({x:saucer.x,y:saucer.y,vx:Math.cos(aim)*250,vy:Math.sin(aim)*250,ttl:2.0,ufo:true});}if(saucer.x<-40||saucer.x>W+40)saucer=null;}else if(rocks.length){saucerT-=dt;if(saucerT<=0){saucerT=Math.max(9,16-wave);const fl=Math.random()<0.5;saucer={x:fl?12:W-12,y:0.2*H+Math.random()*0.6*H,vx:fl?110:-110,vy:(Math.random()-0.5)*40,r:18,fireT:1.3};}}'
    js .= 'powerUps=powerUps.filter(p=>{p.x=(p.x+p.vx*dt+W)%W;p.y=(p.y+p.vy*dt+H)%H;p.ttl-=dt;if(Math.hypot(p.x-ship.x,p.y-ship.y)<=ship.r+18){if(p.kind==="RAPID")ship.rapid=9;else if(p.kind==="SPREAD")ship.spread=9;else ship.shield=10;pops.push({x:p.x,y:p.y,t:p.kind,l:1.0,m:1.0,c:"#34d399"});syncHud();return false;}return p.ttl>0;});'
    js .= 'for(let bi=bolts.length-1;bi>=0;bi--){const b=bolts[bi];if(b.ufo){if(ship.inv<=0&&ship.shield<=0&&Math.hypot(b.x-ship.x,b.y-ship.y)<=ship.r+4){bolts.splice(bi,1);hitShip();}continue;}'
    js .= 'if(saucer&&Math.hypot(b.x-saucer.x,b.y-saucer.y)<=saucer.r+4){bolts.splice(bi,1);addScore(250,saucer.x,saucer.y,"#fbbf24");burst(saucer.x,saucer.y,"#f59e0b",16);const ks=["RAPID","SPREAD","SHIELD"];powerUps.push({kind:ks[Math.floor(Math.random()*ks.length)],x:saucer.x,y:saucer.y,vx:0,vy:12,ttl:10});saucer=null;continue;}'
    js .= 'for(let ri=rocks.length-1;ri>=0;ri--){const r=rocks[ri];if(Math.hypot(b.x-r.x,b.y-r.y)<=r.r+4){bolts.splice(bi,1);destroyRock(ri);break;}}}'
    js .= 'if(ship.inv<=0&&phase==="playing"){if(saucer&&Math.hypot(ship.x-saucer.x,ship.y-saucer.y)<=ship.r+saucer.r*0.85){if(ship.shield>0){ship.shield=0;addScore(250,saucer.x,saucer.y,"#fbbf24");saucer=null;}else hitShip();}else{const ci=rocks.findIndex(r=>Math.hypot(ship.x-r.x,ship.y-r.y)<=ship.r+r.r*0.8);if(ci>=0){if(ship.shield>0){ship.shield=0;ship.inv=1.0;destroyRock(ci);}else hitShip();}}}'
    js .= 'if(!rocks.length&&!saucer){waveT+=dt;if(waveT>=1.2){waveT=0;wave++;spawnWave(wave);syncHud();}}'
    js .= 'parts=parts.filter(p=>{p.x+=p.vx*dt;p.y+=p.vy*dt;p.l-=dt;return p.l>0;});pops=pops.filter(pp=>{pp.y-=26*dt;pp.l-=dt;return pp.l>0;});}'
    js .= 'function draw(now){ctx.clearRect(0,0,W,H);const b=bumperRect();const bc=PSArcadeHost.isMicMuted()?"#ef4444":"#10b981";'
    js .= 'ctx.save();ctx.fillStyle=PSArcadeHost.isMicMuted()?"rgba(239,68,68,0.14)":"rgba(16,185,129,0.14)";ctx.strokeStyle=bc;ctx.lineWidth=2;ctx.beginPath();ctx.roundRect(b.l,b.t,b.r-b.l,b.b-b.t,b.rad);ctx.fill();ctx.stroke();ctx.fillStyle=bc;ctx.font="bold 10px ui-monospace,monospace";ctx.textAlign="center";ctx.textBaseline="middle";ctx.fillText("MIC BUMPER",b.cx,b.cy);ctx.restore();'
    js .= 'powerUps.forEach(p=>{const col=p.kind==="RAPID"?"#f59e0b":(p.kind==="SPREAD"?"#38bdf8":"#34d399");ctx.save();ctx.fillStyle="rgba(15,23,42,0.85)";ctx.strokeStyle=col;ctx.lineWidth=1.8;ctx.beginPath();ctx.roundRect(p.x-28,p.y-11,56,22,11);ctx.fill();ctx.stroke();ctx.fillStyle="#f8fafc";ctx.font="bold 9.5px system-ui";ctx.textAlign="center";ctx.textBaseline="middle";ctx.fillText(p.kind,p.x,p.y);ctx.restore();});'
    js .= 'rocks.forEach(r=>{ctx.save();ctx.fillStyle="rgba(51,65,85,0.45)";ctx.strokeStyle="#e2e8f0";ctx.lineWidth=1.8;ctx.beginPath();r.verts.forEach((v,i)=>{const a=r.ang+(i/r.verts.length)*Math.PI*2,rad=r.r*v,px=r.x+Math.cos(a)*rad,py=r.y+Math.sin(a)*rad;i?ctx.lineTo(px,py):ctx.moveTo(px,py);});ctx.closePath();ctx.fill();ctx.stroke();ctx.restore();});'
    js .= 'if(saucer){ctx.save();ctx.fillStyle="rgba(245,158,11,0.22)";ctx.strokeStyle="#fbbf24";ctx.lineWidth=2;ctx.beginPath();ctx.ellipse(saucer.x,saucer.y,saucer.r,saucer.r*0.45,0,0,Math.PI*2);ctx.fill();ctx.stroke();ctx.beginPath();ctx.arc(saucer.x,saucer.y-saucer.r*0.18,saucer.r*0.45,Math.PI,0);ctx.stroke();ctx.restore();}'
    js .= 'bolts.forEach(bl=>{ctx.fillStyle=bl.ufo?"#f87171":"#38bdf8";ctx.beginPath();ctx.arc(bl.x,bl.y,bl.ufo?3.8:3.1,0,Math.PI*2);ctx.fill();});'
    js .= 'if(lives>0){const blk=ship.inv>0&&(Math.floor(now/80)%2===0);if(!blk){const a=ship.ang,r=ship.r;const nx=ship.x+Math.cos(a)*r*1.25,ny=ship.y+Math.sin(a)*r*1.25,lx=ship.x+Math.cos(a+2.45)*r,ly=ship.y+Math.sin(a+2.45)*r,tx=ship.x-Math.cos(a)*r*0.45,ty=ship.y-Math.sin(a)*r*0.45,rx=ship.x+Math.cos(a-2.45)*r,ry=ship.y+Math.sin(a-2.45)*r;ctx.save();ctx.fillStyle="rgba(16,185,129,0.35)";ctx.strokeStyle="#fff";ctx.lineWidth=2.1;ctx.beginPath();ctx.moveTo(nx,ny);ctx.lineTo(lx,ly);ctx.lineTo(tx,ty);ctx.lineTo(rx,ry);ctx.closePath();ctx.fill();ctx.stroke();if(keys.up||ptr.active){ctx.strokeStyle="#f59e0b";ctx.beginPath();ctx.moveTo((lx+tx)/2,(ly+ty)/2);ctx.lineTo(ship.x-Math.cos(a)*r*1.4,ship.y-Math.sin(a)*r*1.4);ctx.lineTo((rx+tx)/2,(ry+ty)/2);ctx.stroke();}ctx.restore();}if(ship.shield>0){ctx.save();ctx.strokeStyle="#34d399";ctx.lineWidth=2;ctx.beginPath();ctx.arc(ship.x,ship.y,ship.r*1.65,0,Math.PI*2);ctx.stroke();ctx.restore();}}'
    js .= 'parts.forEach(p=>{ctx.globalAlpha=Math.max(0,p.l/p.m);ctx.fillStyle=p.c;ctx.beginPath();ctx.arc(p.x,p.y,2.2,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;});pops.forEach(pp=>{ctx.globalAlpha=Math.max(0,pp.l/pp.m);ctx.fillStyle=pp.c;ctx.font="bold 13px system-ui";ctx.textAlign="center";ctx.fillText(pp.t,pp.x,pp.y);ctx.globalAlpha=1;});}'
    js .= 'function ptrCoord(e){const rc=cvs.getBoundingClientRect();const t=e.touches&&e.touches[0]?e.touches[0]:e;return{x:(t.clientX-rc.left)*(W/rc.width),y:(t.clientY-rc.top)*(H/rc.height)};}'
    js .= 'function onPtrDown(e){const p=ptrCoord(e);ptr={active:true,x:p.x,y:p.y};fire();}'
    js .= 'function onPtrMove(e){if(!ptr.active)return;const p=ptrCoord(e);ptr.x=p.x;ptr.y=p.y;}'
    js .= 'function onPtrUp(){ptr.active=false;}'
    js .= 'function togglePause(){if(phase==="playing"){phase="paused";PSArcadeHost.showCard("PAUSED","Drag to steer & fire, or WASD + Space","Resume");}else if(phase==="paused"){phase="playing";PSArcadeHost.hideCard();}syncHud();}'
    js .= 'const mod={id:"asteroids",title:"ASTEROID BLASTER",'
    js .= 'init:()=>{cvs.addEventListener("pointerdown",onPtrDown);window.addEventListener("pointermove",onPtrMove);window.addEventListener("pointerup",onPtrUp);window.addEventListener("pointercancel",onPtrUp);reset();},'
    js .= 'destroy:()=>{phase="idle";keys={};ptr.active=false;cvs.removeEventListener("pointerdown",onPtrDown);window.removeEventListener("pointermove",onPtrMove);window.removeEventListener("pointerup",onPtrUp);window.removeEventListener("pointercancel",onPtrUp);},'
    js .= 'frame:(now,dt)=>{step(dt);draw(now);},'
    js .= 'onResize:size,onMode:()=>{autoFire=!autoFire;syncHud();},onPause:togglePause,'
    js .= 'onCardAction:()=>{if(phase==="gameover")reset();else togglePause();},'
    js .= 'onKey:(e,isDown)=>{const k=e.key.toLowerCase();'
    js .= 'if(isDown&&k==="escape"){e.preventDefault();stopActive();return true;}'
    js .= 'if(k==="arrowleft"||k==="a"){e.preventDefault();keys.left=isDown;return true;}'
    js .= 'if(k==="arrowright"||k==="d"){e.preventDefault();keys.right=isDown;return true;}'
    js .= 'if(k==="arrowup"||k==="w"){e.preventDefault();keys.up=isDown;return true;}'
    js .= 'if(k===" "){e.preventDefault();if(isDown&&phase==="gameover"){reset();}else{keys.fire=isDown;if(isDown)fire();}return true;}'
    js .= 'if(isDown&&k==="p"){e.preventDefault();togglePause();return true;}'
    js .= 'if(isDown&&k==="r"&&phase==="gameover"){e.preventDefault();reset();return true;}'
    js .= 'if(isDown&&k==="f"){e.preventDefault();autoFire=!autoFire;syncHud();return true;}return false;}};'
    js .= 'return{start:()=>PSArcadeHost.launch(mod),stop:()=>{if(activeMod===mod)stopActive();},toggle:()=>(activeMod===mod)?stopActive():PSArcadeHost.launch(mod),getBest:()=>hi};})();'

    ; 8. Dark-Neon Passcode Terminal Modal + Unlocked About Vault Drawer
    js .= 'const CATALOG=[{id:"snake",title:"HUD Snake",key:"Ctrl+Alt+Shift+S",game:PSWebSnake},{id:"asteroids",title:"Asteroid Blaster",key:"Ctrl+Alt+Shift+A",game:PSWebAsteroids}];'
    js .= 'let termBg=null;'
    js .= 'function renderVaultDrawer(){'
    js .= 'const slot=qs("vaultDrawerSlot"),badge=qs("vaultSlotBadge");'
    js .= 'if(badge){badge.textContent=unlocked?"ARCADE VAULT [99 CREDITS]":"CABINET: LOCKED [0 CREDITS]";badge.style.color=unlocked?"#34d399":"#64748b";badge.style.cursor="pointer";}'
    js .= 'if(!slot)return;if(!unlocked){slot.innerHTML="";slot.classList.add("hide");return;}'
    js .= 'slot.classList.remove("hide");slot.innerHTML="";'
    js .= 'const box=document.createElement("div");box.className="vaultDrawer";'
    js .= 'const hdr=document.createElement("div");hdr.className="row";hdr.style.justifyContent="space-between";'
    js .= 'const tt=document.createElement("b");tt.style.color="#34d399";tt.style.fontSize="12px";tt.textContent="ARCADE VAULT [99 CREDITS]";'
    js .= 'const lk=document.createElement("button");lk.type="button";lk.className="sm dng";lk.textContent="Lock Vault";lk.addEventListener("click",()=>PSArcadeVault.lock());'
    js .= 'hdr.appendChild(tt);hdr.appendChild(lk);box.appendChild(hdr);'
    js .= 'CATALOG.forEach(entry=>{'
    js .= 'const row=document.createElement("div");row.className="vaultGameRow";'
    js .= 'const inf=document.createElement("div");inf.innerHTML="<b>"+entry.title+"</b><div style=\"font-size:11px;color:#94a3b8\">"+entry.key+" · Best "+entry.game.getBest()+"</div>";'
    js .= 'const btn=document.createElement("button");btn.type="button";btn.className="sm act";btn.textContent="Play";btn.addEventListener("click",()=>{const ab=qs("aboutModal");if(ab)ab.classList.add("hide");entry.game.start();});'
    js .= 'row.appendChild(inf);row.appendChild(btn);box.appendChild(row);'
    js .= '});'
    js .= 'slot.appendChild(box);'
    js .= '}'

    js .= 'function openTerminal(){'
    js .= 'if(unlocked){renderVaultDrawer();const ab=qs("aboutModal");if(ab)ab.classList.remove("hide");return;}'
    js .= 'if(!termBg){'
    js .= 'termBg=document.createElement("div");termBg.id="arcTermBg";termBg.className="arcTermBg";'
    js .= 'termBg.innerHTML='
    js .= '"<div class=\"arcTermCard\">"'
    js .= '+"<div style=\"font-size:15px;font-weight:800;color:#38bdf8\">SECTOR Z // TERMINAL</div>"'
    js .= '+"<div id=\"arcTermMsg\" style=\"font-size:12px;color:#94a3b8\">ENTER CABINET CLEARANCE PASSCODE</div>"'
    js .= '+"<input id=\"arcTermIn\" placeholder=\"Passcode...\" autocomplete=\"off\">"'
    js .= '+"<div class=\"row\" style=\"justify-content:space-between\">"'
    js .= '+"<button id=\"arcTermHint\" type=\"button\" class=\"sm\">Hint</button>"'
    js .= '+"<div class=\"row\"><button id=\"arcTermClose\" type=\"button\" class=\"sm\">Cancel</button><button id=\"arcTermGo\" type=\"button\" class=\"sm act\">Submit</button></div>"'
    js .= '+"</div></div>";'
    js .= 'document.body.appendChild(termBg);'
    js .= 'const submit=()=>{if(PSArcadeVault.tryUnlock(qs("arcTermIn").value)){termBg.classList.add("hide");qs("arcTermIn").value="";}else{const m=qs("arcTermMsg");m.textContent="ACCESS DENIED // INVALID TOKEN";m.style.color="#f87171";}};'
    js .= 'qs("arcTermGo").addEventListener("click",submit);'
    js .= 'qs("arcTermIn").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();submit();}else if(e.key==="Escape"){e.preventDefault();termBg.classList.add("hide");}});'
    js .= 'qs("arcTermHint").addEventListener("click",()=>{const m=qs("arcTermMsg");m.style.color="#60cdff";m.textContent=nextClue();});'
    js .= 'qs("arcTermClose").addEventListener("click",()=>termBg.classList.add("hide"));'
    js .= 'termBg.addEventListener("click",e=>{if(e.target===termBg)termBg.classList.add("hide");});'
    js .= '}'
    js .= 'const msg=qs("arcTermMsg");if(msg){msg.textContent="ENTER CABINET CLEARANCE PASSCODE";msg.style.color="#94a3b8";}'
    js .= 'termBg.classList.remove("hide");setTimeout(()=>{try{qs("arcTermIn").focus();}catch(_){}},30);'
    js .= '}'

    js .= 'const PSArcadeVault={'
    js .= 'isUnlocked:()=>unlocked,'
    js .= 'normalizePasscode:normCode,'
    js .= 'tryUnlock:code=>{if(normCode(code)!==PASS_NORM)return false;unlocked=true;renderVaultDrawer();showToast("SECTOR Z UNLOCKED [99 CREDITS]");const ab=qs("aboutModal");if(ab)ab.classList.remove("hide");return true;},'
    js .= 'lock:()=>{unlocked=false;stopActive();if(termBg)termBg.classList.add("hide");renderVaultDrawer();},'
    js .= 'openTerminal,nextClue,games:CATALOG'
    js .= '};'

    ; 9. Wire Breadcrumb Triggers + Global Keyboard Dispatcher
    js .= 'const abVer=qs("aboutVer");'
    js .= 'if(abVer){abVer.style.cursor="pointer";abVer.addEventListener("click",()=>{if(unlocked){renderVaultDrawer();return;}aboutTaps++;clearTimeout(aboutTapTimer);aboutTapTimer=setTimeout(()=>aboutTaps=0,2200);if(aboutTaps>=4&&aboutTaps<7){showToast((7-aboutTaps)+" steps to Sector Z...");}else if(aboutTaps>=7){aboutTaps=0;openTerminal();}});}'
    js .= 'const badge=qs("vaultSlotBadge");'
    js .= 'if(badge){badge.addEventListener("click",()=>{if(unlocked){renderVaultDrawer();}else{showToast(nextClue());}});}'
    js .= 'renderVaultDrawer();'

    js .= 'document.addEventListener("keydown",e=>{'
    js .= 'if(activeMod&&activeMod.onKey&&activeMod.onKey(e,true))return;'
    js .= 'const tgt=e.target,isInput=tgt&&(tgt.tagName==="INPUT"||tgt.tagName==="TEXTAREA"||tgt.isContentEditable);'
    js .= 'if(e.ctrlKey&&e.altKey&&e.shiftKey){'
    js .= 'const ch=e.key.toLowerCase();'
    js .= 'if(ch==="z"){e.preventDefault();openTerminal();return;}'
    js .= 'if(ch==="s"){e.preventDefault();PSWebSnake.toggle();return;}'
    js .= 'if(ch==="a"){e.preventDefault();PSWebAsteroids.toggle();return;}'
    js .= '}'
    js .= 'if(!isInput&&!unlocked){'
    js .= 'const k=e.key.toLowerCase();'
    js .= 'if(k===konamiSeq[konamiPos]){konamiPos++;if(konamiPos>=konamiSeq.length){konamiPos=0;e.preventDefault();openTerminal();}}else{konamiPos=(k===konamiSeq[0])?1:0;}'
    js .= '}'
    js .= '});'
    js .= 'document.addEventListener("keyup",e=>{if(activeMod&&activeMod.onKey)activeMod.onKey(e,false);});'

    js .= 'window.PSArcadeVault=PSArcadeVault;'
    js .= 'window.PSArcadeHost=PSArcadeHost;'
    js .= 'window.PSWebSnake=PSWebSnake;'
    js .= 'window.PSWebAsteroids=PSWebAsteroids;'
    js .= '})();'
    return js
}
