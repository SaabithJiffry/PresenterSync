    js .= 'for(let i=blasts.length-1;i>=0;i--){const b=blasts[i];b.age+=dt;if(b.age>=b.life)blasts.splice(i,1);else{const f=Math.min(1,b.age/0.42);b.r=8+(b.maxR-8)*(1-(1-f)*(1-f));}}'
    js .= 'for(let i=meteors.length-1;i>=0;i--){const m=meteors[i];m.tr.push({x:m.x,y:m.y});if(m.tr.length>8)m.tr.shift();m.x+=m.vx*dt;m.y+=m.vy*dt;'
    js .= 'if(m.sp&&!m.splitDone&&m.y>=m.splitY){m.splitDone=true;m.sp=false;const cs=Math.max(65,Math.hypot(m.vx,m.vy));'
