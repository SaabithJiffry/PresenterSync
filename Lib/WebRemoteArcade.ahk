    js .= 'function fits(k,px,py,r){const cs=SH[k][r&3];for(let i=0;i<4;i++){const bx=px+cs[i][0],by=py+cs[i][1];if(bx<0||bx>=COLS||by>=ROWS)return false;if(by>=0&&board[by][bx])return false;}return true;}'
    js .= 'function gameOver(){phase="gameover";if(score>hi){hi=score;localStorage.setItem("ps_arcade_hi_block_drop",String(hi));}syncHud();PSArcadeHost.showCard("GAME OVER","Score "+score+" · Best "+hi+" · Lvl "+level,"Play Again");}'
    js .= 'function spawnKind(k){curKind=k;curRot=0;curX=3;curY=(k==="I")?-1:0;gravAcc=0;lockT=0;lockResets=0;lastRot=false;if(!fits(curKind,curX,curY,curRot))gameOver();}'
