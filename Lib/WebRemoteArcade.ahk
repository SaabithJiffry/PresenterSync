    js .= 'function syncHud(){const c=combo>1?" · x"+combo:"";PSArcadeHost.setHud(score,hi,"WAVE "+wave+" · PYLONS "+aliveCnt()+"/4"+c,"",phase==="paused"?"Resume (P)":"Pause (P)",false);}'
    js .= 'function addScore(pts,x,y,col,lbl){score+=pts;if(score>hi){hi=score;localStorage.setItem("ps_arcade_hi_missile_defense",String(hi));}pops.push({x,y,t:lbl||("+"+pts),l:0.85,m:0.85,c:col});syncHud();}'
    js .= 'function burst(x,y,c,n){for(let i=0;i<n;i++){const a=Math.random()*Math.PI*2,sp=40+Math.random()*110;parts.push({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,l:0.4,m:0.4,c});}}'
    js .= 'function startWave(w){wave=w;wavePend=5+w*3;spawnCd=0.42;syncHud();}'
