    js .= 'ctx.strokeStyle="rgba(56,189,248,0.8)";ctx.lineWidth=1.4;ctx.beginPath();ctx.arc(ret.x,ret.y,9,0,Math.PI*2);ctx.moveTo(ret.x-13,ret.y);ctx.lineTo(ret.x+13,ret.y);ctx.moveTo(ret.x,ret.y-13);ctx.lineTo(ret.x,ret.y+13);ctx.stroke();'
