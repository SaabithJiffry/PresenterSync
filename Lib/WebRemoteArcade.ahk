    js .= 'ctx.strokeStyle=inSh?"rgba(250,204,21,0.4)":"#ef4444";ctx.beginPath();ctx.moveTo(360,80);ctx.lineTo(360,155);ctx.stroke();'
    js .= 'ctx.strokeStyle="#f59e0b";ctx.lineWidth=6;ctx.beginPath();ctx.moveTo(378,665+pCh*16);ctx.lineTo(378,684);ctx.stroke();'
    js .= 'ctx.textAlign="center";ctx.font="700 10px ui-monospace,monospace";rolls.forEach(r=>{ctx.fillStyle=r.lit?"rgba(250,204,21,0.35)":"rgba(15,23,42,0.5)";ctx.beginPath();ctx.arc(r.x,r.y,r.r,0,Math.PI*2);ctx.fill();ctx.strokeStyle=r.lit?"#facc15":"#64748b";ctx.lineWidth=1.8;ctx.stroke();ctx.fillStyle=r.lit?"#fef08a":"#94a3b8";ctx.fillText(r.lbl,r.x,r.y+3.5);});'
    js .= 'drops.forEach(d=>{ctx.fillStyle=d.dn?"rgba(71,85,105,0.25)":(d.fl>0?"#fff":"#22c55e");ctx.fillRect(d.x,d.y,d.w,d.h);});'
    js .= 'slings.forEach(s=>{ctx.strokeStyle=s.fl>0?"#fde047":"#a855f7";ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(s.ax,s.ay);ctx.lineTo(s.bx,s.by);ctx.stroke();ctx.strokeStyle="#64748b";ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(s.bx,s.by);ctx.lineTo(s.cx,s.cy);ctx.lineTo(s.ax,s.ay);ctx.stroke();});'
    js .= 'bumps.forEach(b=>{const c=b.lv===1?"#06b6d4":(b.lv===2?"#f59e0b":"#ec4899");ctx.fillStyle=b.fl>0?"rgba(255,255,255,0.8)":(b.lv===1?"rgba(6,182,212,0.3)":"rgba(245,158,11,0.3)");ctx.beginPath();ctx.arc(b.x,b.y,b.r,0,Math.PI*2);ctx.fill();ctx.strokeStyle=c;ctx.lineWidth=2.5;ctx.stroke();});'
    js .= 'ctx.fillStyle="#c084fc";ctx.font="700 12px ui-monospace,monospace";ctx.fillText(RANKS[rankIdx].toUpperCase()+" ("+mult+"x)",192,380);'
    js .= 'if(bSave>0){ctx.fillStyle="#22c55e";ctx.fillText("BALL SAVE",192,610);}'
    js .= 'ctx.strokeStyle=tilted?"#64748b":"#38bdf8";ctx.lineWidth=11;ctx.beginPath();ctx.moveTo(120,628);ctx.lineTo(120+Math.cos(lAng)*58,628+Math.sin(lAng)*58);ctx.stroke();'
    js .= 'ctx.beginPath();ctx.moveTo(264,628);ctx.lineTo(264+Math.cos(rAng)*58,628+Math.sin(rAng)*58);ctx.stroke();'
    js .= 'trail.forEach((pt,i)=>{ctx.fillStyle="rgba(56,189,248,"+((i+1)*0.07)+")";ctx.beginPath();ctx.arc(pt.x,pt.y,BR*0.65,0,Math.PI*2);ctx.fill();});'
    js .= 'ctx.fillStyle="#f8fafc";ctx.beginPath();ctx.arc(bx,by,BR,0,Math.PI*2);ctx.fill();ctx.strokeStyle="#38bdf8";ctx.lineWidth=2;ctx.stroke();'
    js .= 'pops.forEach((p,i)=>{ctx.fillStyle=p.c;ctx.fillText(p.t,192,420+i*20);});ctx.restore();}'
    js .= 'function syncTouch(){lDown=false;rDown=false;ptrs.forEach(side=>{if(side==="L")lDown=true;else rDown=true;});}'
    js .= 'function onPDown(e){if(phase!=="playing")return;const r=cvs.getBoundingClientRect(),tx=(e.clientX-r.left)/sc,ty=(e.clientY-r.top)/sc;if(inSh&&tx>=340&&ty>=460){shPid=e.pointerId;pHeld=true;return;}ptrs.set(e.pointerId,tx<TW*0.5?"L":"R");syncTouch();}'
    js .= 'function onPUp(e){if(e.pointerId===shPid){shPid=null;if(pHeld){pHeld=false;relPlung();}}ptrs.delete(e.pointerId);syncTouch();}'
    js .= 'function togglePause(){if(phase==="playing"){phase="paused";PSArcadeHost.showCard("PAUSED","Flippers: Left/Right, Z//, Tap L/R · Launch: Space · Nudge: Up/X","Resume");}else if(phase==="paused"){phase="playing";PSArcadeHost.hideCard();}syncHud();}'
    js .= 'const mod={id:"pinball",title:"SPACE CADET PINBALL",'
    js .= 'init:()=>{cvs.addEventListener("pointerdown",onPDown);cvs.addEventListener("pointerup",onPUp);cvs.addEventListener("pointercancel",onPUp);reset();},'
    js .= 'destroy:()=>{phase="idle";ptrs.clear();shPid=null;pHeld=false;kbL=false;kbR=false;lDown=false;rDown=false;cvs.removeEventListener("pointerdown",onPDown);cvs.removeEventListener("pointerup",onPUp);cvs.removeEventListener("pointercancel",onPUp);},'
    js .= 'frame:(now,dt)=>{step(dt);draw();},onResize:size,onPause:togglePause,onMode:nudge,'
    js .= 'onCardAction:()=>{if(phase==="gameover")reset();else togglePause();},'
    js .= 'onKey:(e,isDown)=>{const k=e.key.toLowerCase();'
    js .= 'if(k==="arrowleft"||k==="z"||e.code==="ShiftLeft"){e.preventDefault();kbL=isDown;return true;}'
    js .= 'if(k==="arrowright"||k==="/"||e.code==="ShiftRight"){e.preventDefault();kbR=isDown;return true;}'
    js .= 'if(k===" "||k==="arrowdown"){e.preventDefault();if(isDown){if(phase==="gameover")reset();else pHeld=true;}else if(pHeld){pHeld=false;relPlung();}return true;}'
    js .= 'if(!isDown)return false;'
    js .= 'if(k==="escape"){e.preventDefault();stopActive();return true;}'
    js .= 'if(k==="arrowup"||k==="x"){e.preventDefault();nudge();return true;}'
    js .= 'if(k==="p"){e.preventDefault();togglePause();return true;}'
    js .= 'if(k==="r"&&phase==="gameover"){e.preventDefault();reset();return true;}return false;}};'
    js .= 'return{start:()=>PSArcadeHost.launch(mod),stop:()=>{if(activeMod===mod)stopActive();},toggle:()=>(activeMod===mod)?stopActive():PSArcadeHost.launch(mod),getBest:()=>hi};})();'

    ; 8. Dark-Neon Passcode Terminal Modal + Unlocked About Vault Drawer
    js .= 'const CATALOG=['
    js .= '{id:"snake",title:"HUD Snake",key:"Ctrl+Alt+Shift+S",game:PSWebSnake},'
    js .= '{id:"asteroids",title:"Asteroid Blaster",key:"Ctrl+Alt+Shift+A",game:PSWebAsteroids},'
    js .= '{id:"brick_breaker",title:"Brick Breaker",key:"Ctrl+Alt+Shift+B",game:PSWebBrickBreaker},'
    js .= '{id:"cyber_pong",title:"Cyber Pong",key:"Ctrl+Alt+Shift+H",game:PSWebCyberPong},'
    js .= '{id:"flappy",title:"Clicker Flappy / Wave",key:"Ctrl+Alt+Shift+F",game:PSWebFlappy},'
    js .= '{id:"tron",title:"Neon Light Cycles (TRON)",key:"Ctrl+Alt+Shift+T",game:PSWebLightCycles},'
    js .= '{id:"pac_grid",title:"Neon Pac-Grid",key:"Ctrl+Alt+Shift+C",game:PSWebPacGrid},'
    js .= '{id:"missile_defense",title:"Missile Defense",key:"Ctrl+Alt+Shift+M",game:PSWebMissileDefense},'
    js .= '{id:"block_drop",title:"Neon Block Drop",key:"Ctrl+Alt+Shift+D",game:PSWebBlockDrop},'
    js .= '{id:"pinball",title:"Space Cadet Pinball",key:"Ctrl+Alt+Shift+P",game:PSWebPinball}'
    js .= '];'
    js .= 'let termBg=null;'
    js .= 'function renderVaultDrawer(){'
    js .= 'const slot=qs("vaultDrawerSlot"),badge=qs("vaultSlotBadge");'
    js .= 'if(badge){badge.textContent=unlocked?"ARCADE VAULT [99 CREDITS]":"CABINET: LOCKED [0 CREDITS]";badge.style.color=unlocked?"#34d399":"#64748b";badge.style.cursor="pointer";}'
    js .= 'if(!slot)return;if(!unlocked){slot.innerHTML="";slot.classList.add("hide");return;}'
    js .= 'slot.classList.remove("hide");slot.innerHTML="";'
    js .= 'const box=document.createElement("div");box.className="vaultDrawer";'
    js .= 'const hdr=document.createElement("div");hdr.className="row";hdr.style.justifyContent="space-between";'
    js .= 'const tt=document.createElement("b");tt.style.color="#34d399";tt.style.fontSize="12px";tt.textContent="ARCADE VAULT [99 CREDITS]";'
    js .= 'const lk=document.createElement("button");lk.type="button";lk.className="sm dng";lk.textContent="Lock Vault";lk.addEventListener("click",()=>PSArcadeVault.lock());'
    js .= 'hdr.appendChild(tt);hdr.appendChild(lk);box.appendChild(hdr);'
    js .= 'CATALOG.forEach(entry=>{'
    js .= 'const row=document.createElement("div");row.className="vaultGameRow";'
    js .= 'const inf=document.createElement("div");inf.innerHTML="<b>"+entry.title+"</b><div style=\"font-size:11px;color:#94a3b8\">"+entry.key+" · Best "+entry.game.getBest()+"</div>";'
    js .= 'const btn=document.createElement("button");btn.type="button";btn.className="sm act";btn.textContent="Play";btn.addEventListener("click",()=>{const ab=qs("aboutModal");if(ab)ab.classList.add("hide");entry.game.start();});'
    js .= 'row.appendChild(inf);row.appendChild(btn);box.appendChild(row);'
    js .= '});'
    js .= 'slot.appendChild(box);'
    js .= '}'

    js .= 'function openTerminal(){'
    js .= 'if(unlocked){renderVaultDrawer();const ab=qs("aboutModal");if(ab)ab.classList.remove("hide");return;}'
    js .= 'if(!termBg){'
    js .= 'termBg=document.createElement("div");termBg.id="arcTermBg";termBg.className="arcTermBg";'
    js .= 'termBg.innerHTML='
    js .= '"<div class=\"arcTermCard\">"'
    js .= '+"<div style=\"font-size:15px;font-weight:800;color:#38bdf8\">SECTOR Z // TERMINAL</div>"'
    js .= '+"<div id=\"arcTermMsg\" style=\"font-size:12px;color:#94a3b8\">ENTER CABINET CLEARANCE PASSCODE</div>"'
    js .= '+"<input id=\"arcTermIn\" placeholder=\"Passcode...\" autocomplete=\"off\">"'
    js .= '+"<div class=\"row\" style=\"justify-content:space-between\">"'
    js .= '+"<button id=\"arcTermHint\" type=\"button\" class=\"sm\">Hint</button>"'
    js .= '+"<div class=\"row\"><button id=\"arcTermClose\" type=\"button\" class=\"sm\">Cancel</button><button id=\"arcTermGo\" type=\"button\" class=\"sm act\">Submit</button></div>"'
    js .= '+"</div></div>";'
    js .= 'document.body.appendChild(termBg);'
    js .= 'const submit=()=>{if(PSArcadeVault.tryUnlock(qs("arcTermIn").value)){termBg.classList.add("hide");qs("arcTermIn").value="";}else{const m=qs("arcTermMsg");m.textContent="ACCESS DENIED // INVALID TOKEN";m.style.color="#f87171";}};'
    js .= 'qs("arcTermGo").addEventListener("click",submit);'
    js .= 'qs("arcTermIn").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();submit();}else if(e.key==="Escape"){e.preventDefault();termBg.classList.add("hide");}});'
    js .= 'qs("arcTermHint").addEventListener("click",()=>{const m=qs("arcTermMsg");m.style.color="#60cdff";m.textContent=nextClue();});'
    js .= 'qs("arcTermClose").addEventListener("click",()=>termBg.classList.add("hide"));'
    js .= 'termBg.addEventListener("click",e=>{if(e.target===termBg)termBg.classList.add("hide");});'
    js .= '}'
    js .= 'const msg=qs("arcTermMsg");if(msg){msg.textContent="ENTER CABINET CLEARANCE PASSCODE";msg.style.color="#94a3b8";}'
    js .= 'termBg.classList.remove("hide");setTimeout(()=>{try{qs("arcTermIn").focus();}catch(_){}},30);'
    js .= '}'

    js .= 'const PSArcadeVault={'
    js .= 'isUnlocked:()=>unlocked,'
    js .= 'normalizePasscode:normCode,'
    js .= 'tryUnlock:code=>{if(normCode(code)!==PASS_NORM)return false;unlocked=true;renderVaultDrawer();showToast("SECTOR Z UNLOCKED [99 CREDITS]");const ab=qs("aboutModal");if(ab)ab.classList.remove("hide");return true;},'
    js .= 'lock:()=>{unlocked=false;stopActive();if(termBg)termBg.classList.add("hide");renderVaultDrawer();},'
    js .= 'openTerminal,nextClue,games:CATALOG'
    js .= '};'

    ; 9. Wire Breadcrumb Triggers + Global Keyboard Dispatcher
    js .= 'const abVer=qs("aboutVer");'
    js .= 'if(abVer){abVer.style.cursor="pointer";abVer.addEventListener("click",()=>{if(unlocked){renderVaultDrawer();return;}aboutTaps++;clearTimeout(aboutTapTimer);aboutTapTimer=setTimeout(()=>aboutTaps=0,2200);if(aboutTaps>=4&&aboutTaps<7){showToast((7-aboutTaps)+" steps to Sector Z...");}else if(aboutTaps>=7){aboutTaps=0;openTerminal();}});}'
    js .= 'const badge=qs("vaultSlotBadge");'
    js .= 'if(badge){badge.addEventListener("click",()=>{if(unlocked){renderVaultDrawer();}else{showToast(nextClue());}});}'
    js .= 'renderVaultDrawer();'

    js .= 'document.addEventListener("keydown",e=>{'
    js .= 'if(activeMod&&activeMod.onKey&&activeMod.onKey(e,true))return;'
    js .= 'const tgt=e.target,isInput=tgt&&(tgt.tagName==="INPUT"||tgt.tagName==="TEXTAREA"||tgt.isContentEditable);'
    js .= 'if(e.ctrlKey&&e.altKey&&e.shiftKey){'
    js .= 'const ch=e.key.toLowerCase();'
    js .= 'if(ch==="z"){e.preventDefault();openTerminal();return;}'
    js .= 'if(ch==="s"){e.preventDefault();PSWebSnake.toggle();return;}'
    js .= 'if(ch==="a"){e.preventDefault();PSWebAsteroids.toggle();return;}'
    js .= 'if(ch==="b"){e.preventDefault();PSWebBrickBreaker.toggle();return;}'
    js .= 'if(ch==="h"){e.preventDefault();PSWebCyberPong.toggle();return;}'
    js .= 'if(ch==="f"){e.preventDefault();PSWebFlappy.toggle();return;}'
    js .= 'if(ch==="t"){e.preventDefault();PSWebLightCycles.toggle();return;}'
    js .= 'if(ch==="c"){e.preventDefault();PSWebPacGrid.toggle();return;}'
    js .= 'if(ch==="m"){e.preventDefault();PSWebMissileDefense.toggle();return;}'
    js .= 'if(ch==="d"){e.preventDefault();PSWebBlockDrop.toggle();return;}'
    js .= 'if(ch==="p"){e.preventDefault();PSWebPinball.toggle();return;}'
    js .= '}'
    js .= 'if(!isInput&&!unlocked){'
    js .= 'const k=e.key.toLowerCase();'
    js .= 'if(k===konamiSeq[konamiPos]){konamiPos++;if(konamiPos>=konamiSeq.length){konamiPos=0;e.preventDefault();openTerminal();}}else{konamiPos=(k===konamiSeq[0])?1:0;}'
    js .= '}'
    js .= '});'
    js .= 'document.addEventListener("keyup",e=>{if(activeMod&&activeMod.onKey)activeMod.onKey(e,false);});'

    js .= 'window.PSArcadeVault=PSArcadeVault;'
    js .= 'window.PSArcadeHost=PSArcadeHost;'
    js .= 'window.PSWebSnake=PSWebSnake;'
    js .= 'window.PSWebAsteroids=PSWebAsteroids;'
    js .= 'window.PSWebBrickBreaker=PSWebBrickBreaker;'
    js .= 'window.PSWebCyberPong=PSWebCyberPong;'
    js .= 'window.PSWebFlappy=PSWebFlappy;'
    js .= 'window.PSWebLightCycles=PSWebLightCycles;'
    js .= 'window.PSWebPacGrid=PSWebPacGrid;'
    js .= 'window.PSWebMissileDefense=PSWebMissileDefense;'
    js .= 'window.PSWebBlockDrop=PSWebBlockDrop;'
    js .= 'window.PSWebPinball=PSWebPinball;'
    js .= '})();'
    return js
}
