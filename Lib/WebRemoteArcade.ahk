; ==============================================================================
; Module: WebRemoteArcade.ahk
; Description: Confidential Sector Z RAM-only Master Arcade Vault and HTML5
;              Canvas2D arcade suite served on GET /arcade.js by HostBridge.ahk.
; ==============================================================================

#Requires AutoHotkey v2.0

BuildWebRemoteArcadeJs() {
    js := '(()=>{ "use strict";'
    js .= 'if(window.PSArcadeVault)return;'
    js .= 'const qs=id=>document.getElementById(id);'

    ; 1. Subtle DevTools console Sector Z banner (never prints passcode)
    js .= 'try{console.log("%c  ____  _____ ____ _____ ___  ____    _____ \n / ___|| ____/ ___|_   _/ _ \\|  _ \\  |__  / \n \\___ \\|  _|| |     | || | | | |_) |   / /  \n  ___) | |__| |___  | || |_| |  _ <   / /_  \n |____/|_____\\____| |_| \\___/|_| \\_\\ /____| \n%c[SECTOR Z // CABINET STANDBY: 0 CREDITS]","color:#38bdf8;font-weight:700","color:#94a3b8;font-family:monospace");}catch(_){}'

    ; 2. Inject crisp dark-glass Sector Z + Arcade Host CSS once
    js .= 'const st=document.createElement("style");'
    js .= 'st.textContent='
    js .= '".arcOverlay{position:fixed;inset:0;z-index:9999;background:rgba(7,11,20,0.82);backdrop-filter:blur(7px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:12px;user-select:none;touch-action:none}"'
    js .= '+".arcHud{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:center;background:rgba(19,23,34,0.92);border:1px solid rgba(255,255,255,0.16);border-radius:999px;padding:6px 14px;font-size:12px;box-shadow:0 8px 28px rgba(0,0,0,.5);color:#f1f5f9}"'
    js .= '+".arcBadge{font-weight:800;letter-spacing:.6px;color:#38bdf8}"'
    js .= '+".arcMicBadge{font-size:10.5px;font-weight:800;padding:3px 9px;border-radius:999px;color:#fff;letter-spacing:.4px}"'
    js .= '+".arcMicBadge.live{background:#107c10}.arcMicBadge.muted{background:#c42b1c}"'
    js .= '+".arcCanvas{border-radius:14px;background:rgba(10,15,26,0.72);border:1px solid rgba(148,163,184,0.22);box-shadow:0 16px 48px rgba(0,0,0,.6);max-width:100%;max-height:76vh}"'
    js .= '+".arcCard{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);min-width:260px;max-width:90vw;background:rgba(15,23,42,0.96);border:1px solid rgba(56,189,248,.35);border-radius:16px;padding:18px;text-align:center;box-shadow:0 18px 50px rgba(0,0,0,.7);display:flex;flex-direction:column;gap:10px;z-index:10002;color:#f1f5f9}"'
    js .= '+".arcDpad{display:grid;grid-template-columns:repeat(3,48px);grid-template-rows:repeat(2,44px);gap:6px;margin-top:4px}"'
    js .= '+".arcDpad button{padding:0;font-size:16px;border-radius:10px;background:rgba(30,36,51,.9);color:#f1f5f9}"'
    js .= '+".arcTermBg{position:fixed;inset:0;z-index:10010;background:rgba(4,6,12,.85);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:16px}"'
    js .= '+".arcTermCard{width:100%;max-width:390px;background:#070b14;border:1.5px solid #38bdf8;border-radius:14px;padding:18px;box-shadow:0 20px 56px rgba(0,0,0,.8);display:flex;flex-direction:column;gap:11px;font-family:ui-monospace,Consolas,monospace;color:#e2e8f0}"'
    js .= '+".arcToast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);z-index:10020;background:#0f172a;border:1px solid #38bdf8;color:#e2e8f0;font-family:ui-monospace,Consolas,monospace;font-size:12px;padding:8px 14px;border-radius:10px;box-shadow:0 10px 28px rgba(0,0,0,.6)}"'
    js .= '+".vaultDrawer{margin-top:8px;padding:12px;background:#090d16;border:1px solid #10b981;border-radius:12px;display:flex;flex-direction:column;gap:8px}"'
    js .= '+".vaultGameRow{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:12px;background:#111827;padding:8px 10px;border-radius:9px;border:1px solid #1f2937}";'
    js .= 'document.head.appendChild(st);'

    ; 3. Transient Toast helper
    js .= 'let toastTimer=null;'
    js .= 'function showToast(msg){let el=qs("arcToastEl");if(!el){el=document.createElement("div");el.id="arcToastEl";el.className="arcToast";document.body.appendChild(el);}el.textContent=msg;el.classList.remove("hide");clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.add("hide"),3200);}'

    ; 4. Shared RAM-Only Master Arcade Vault (`INSERTCOIN`)
    js .= 'const PASS_NORM="INSERTCOIN";'
    js .= 'const CLUES=['
    js .= '"SECTOR Z // CLEARANCE REQUIRED - Cabinet Bus at 0 Credits.",'
    js .= '"Konami impulse or 7-pulse build telemetry opens the coin slot.",'
    js .= '"Classic twin-word coin-op start legend waits inside the terminal.",'
    js .= '"Desktop chord Ctrl+Alt+Shift+Z activates the local terminal bridge."'
    js .= '];'
    js .= 'let unlocked=false,clueIdx=0,aboutTaps=0,aboutTapTimer=null;'
    js .= 'const konamiSeq=["arrowup","arrowup","arrowdown","arrowdown","arrowleft","arrowright","arrowleft","arrowright"];'
    js .= 'let konamiPos=0;'
    js .= 'function normCode(s){return String(s||"").toUpperCase().replace(/[^A-Z0-9]/g,"");}'
    js .= 'function nextClue(){const c=CLUES[clueIdx%CLUES.length];clueIdx=(clueIdx+1)%CLUES.length;return c;}'

    ; 5. Build Shared Arcade Host Overlay DOM
    js .= 'const wrap=document.createElement("div");wrap.id="arcWrap";wrap.className="arcOverlay hide";wrap.setAttribute("role","dialog");wrap.setAttribute("aria-label","Arcade Overlay");'
    js .= 'wrap.innerHTML='
    js .= '"<div class=\"arcHud\">"'
    js .= '+"<b id=\"arcGameTitle\" class=\"arcBadge\">ARCADE</b>"'
    js .= '+"<span id=\"arcMicBadge\" class=\"arcMicBadge live\">MIC LIVE</span>"'
    js .= '+"<span>SCORE <b id=\"arcScore\">0</b></span>"'
    js .= '+"<span>BEST <b id=\"arcBest\">0</b></span>"'
    js .= '+"<span id=\"arcExtraStat\"></span>"'
    js .= '+"<button id=\"arcModeBtn\" type=\"button\" class=\"sm hide\"></button>"'
    js .= '+"<button id=\"arcPauseBtn\" type=\"button\" class=\"sm\">Pause (P)</button>"'
    js .= '+"<button id=\"arcPadBtn\" type=\"button\" class=\"sm hide\">D-Pad</button>"'
    js .= '+"<button id=\"arcExitBtn\" type=\"button\" class=\"sm dng\">Exit (Esc)</button>"'
    js .= '+"</div>"'
    js .= '+"<canvas id=\"arcCanvas\" class=\"arcCanvas\"></canvas>"'
    js .= '+"<div id=\"arcDpad\" class=\"arcDpad hide\">"'
    js .= '+"<div></div><button type=\"button\" data-adir=\"0,-1\">&#9650;</button><div></div>"'
    js .= '+"<button type=\"button\" data-adir=\"-1,0\">&#9664;</button><button type=\"button\" data-adir=\"0,1\">&#9660;</button><button type=\"button\" data-adir=\"1,0\">&#9654;</button>"'
    js .= '+"</div>"'
    js .= '+"<div id=\"arcCard\" class=\"arcCard hide\">"'
    js .= '+"<div id=\"arcCardTitle\" style=\"font-size:18px;font-weight:800\">PAUSED</div>"'
    js .= '+"<div id=\"arcCardSub\" style=\"font-size:12.5px;color:#94a3b8\">Press Space or tap Resume</div>"'
    js .= '+"<div class=\"row\" style=\"justify-content:center\">"'
    js .= '+"<button id=\"arcCardAct\" type=\"button\" class=\"act grow\">Resume</button>"'
    js .= '+"<button id=\"arcCardExit\" type=\"button\" class=\"dng\">Exit</button>"'
    js .= '+"</div></div>";'
    js .= 'document.body.appendChild(wrap);'

    js .= 'const cvs=qs("arcCanvas"),ctx=cvs.getContext("2d");'
    js .= 'let activeMod=null,micMuted=false,rafId=0,lastTickMs=0;'

    js .= 'const PSArcadeHost={'
    js .= 'setMicMuted:m=>{micMuted=!!m;const b=qs("arcMicBadge");if(b){b.textContent=micMuted?"MIC MUTED":"MIC LIVE";b.className="arcMicBadge "+(micMuted?"muted":"live");}},'
    js .= 'isMicMuted:()=>micMuted,'
    js .= 'setHud:(score,best,extraHtml,modeLabel,pauseLabel,showPad)=>{'
    js .= 'qs("arcScore").textContent=String(score);qs("arcBest").textContent=String(best);'
    js .= 'qs("arcExtraStat").textContent=extraHtml||"";'
    js .= 'const mb=qs("arcModeBtn");if(modeLabel){mb.textContent=modeLabel;mb.classList.remove("hide");}else{mb.classList.add("hide");}'
    js .= 'qs("arcPauseBtn").textContent=pauseLabel||"Pause (P)";'
    js .= 'qs("arcPadBtn").classList.toggle("hide",!showPad);'
    js .= '},'
    js .= 'showCard:(t,sub,btn)=>{qs("arcCardTitle").textContent=t;qs("arcCardSub").textContent=sub;qs("arcCardAct").textContent=btn;qs("arcCard").classList.remove("hide");},'
    js .= 'hideCard:()=>qs("arcCard").classList.add("hide"),'
    js .= 'canvas:cvs,ctx:ctx,dpad:qs("arcDpad"),'
    js .= 'launch:mod=>{if(!unlocked){showToast(nextClue());openTerminal();return false;}stopActive();activeMod=mod;wrap.classList.remove("hide");qs("arcCard").classList.add("hide");qs("arcGameTitle").textContent=mod.title;lastTickMs=performance.now();mod.init();rafId=requestAnimationFrame(hostLoop);return true;},'
    js .= 'stop:stopActive,'
    js .= 'isActive:()=>activeMod!==null'
    js .= '};'

    js .= 'function stopActive(){if(rafId){cancelAnimationFrame(rafId);rafId=0;}if(activeMod&&activeMod.destroy)activeMod.destroy();activeMod=null;wrap.classList.add("hide");qs("arcCard").classList.add("hide");qs("arcDpad").classList.add("hide");}'
    js .= 'function hostLoop(now){if(!activeMod)return;const dt=Math.min(0.05,Math.max(0.001,(now-lastTickMs)/1000));lastTickMs=now;activeMod.frame(now,dt);rafId=requestAnimationFrame(hostLoop);}'
    js .= 'qs("arcModeBtn").addEventListener("click",()=>{if(activeMod&&activeMod.onMode)activeMod.onMode();});'
    js .= 'qs("arcPauseBtn").addEventListener("click",()=>{if(activeMod&&activeMod.onPause)activeMod.onPause();});'
    js .= 'qs("arcPadBtn").addEventListener("click",()=>qs("arcDpad").classList.toggle("hide"));'
    js .= 'qs("arcExitBtn").addEventListener("click",stopActive);'
    js .= 'qs("arcCardExit").addEventListener("click",stopActive);'
    js .= 'qs("arcCardAct").addEventListener("click",()=>{if(activeMod&&activeMod.onCardAction)activeMod.onCardAction();});'
    js .= 'document.querySelectorAll("[data-adir]").forEach(b=>b.addEventListener("click",()=>{if(activeMod&&activeMod.onDpad){const[dx,dy]=b.dataset.adir.split(",").map(Number);activeMod.onDpad(dx,dy);}}));'
    js .= 'window.addEventListener("resize",()=>{if(activeMod&&activeMod.onResize)activeMod.onResize();});'

    ; 6. Web Game #1: HUD Snake (Adaptation #6: corner-anchored 90-deg polyline + translucent matte-glass)
    js .= 'const PSWebSnake=(()=>{const cols=24,rows=18;let cell=20,phase="idle",snake=[],prevSnake=[],dir={x:-1,y:0},q=[],grow=0,stepGrew=false,crashDir={x:0,y:0},score=0,eaten=0,wrapMode=false,stepMs=132,stepStart=0,frozen=0,food=null,pops=[],touch0=null;'
    js .= 'const snkBuf=document.createElement("canvas"),bctx=snkBuf.getContext("2d");'
    js .= 'let hi=parseInt(localStorage.getItem("ps_arcade_hi_snake")||"0",10)||0;'
    js .= 'function size(){const mw=Math.min(640,window.innerWidth-28),mh=Math.min(460,window.innerHeight-180);cell=Math.max(14,Math.min(26,Math.floor(Math.min(mw/cols,mh/rows))));cvs.width=cols*cell;cvs.height=rows*cell;snkBuf.width=cvs.width;snkBuf.height=cvs.height;}'
    js .= 'function clone(a){return a.map(p=>({col:p.col,row:p.row}));}'
    js .= 'function spawnFood(kind){const used=new Set(snake.map(s=>s.col+","+s.row));const free=[];for(let c=0;c<cols;c++)for(let r=0;r<rows;r++)if(!used.has(c+","+r))free.push({c,r});if(!free.length)return;const pick=free[Math.floor(Math.random()*free.length)];const isB=(kind==="bonus");food={col:pick.c,row:pick.r,kind:kind||"normal",born:performance.now(),ttl:isB?7000:0,pts:isB?30:10};}'
    js .= 'function syncHud(){PSArcadeHost.setHud(score,hi,"LEN "+snake.length,(wrapMode?"WRAP":"WALLS")+" (E)",phase==="paused"?"Resume (P)":"Pause (P)",true);}'
    js .= 'function reset(){size();const mx=Math.floor(cols/2),my=Math.floor(rows/2);snake=[{col:mx,row:my},{col:mx+1,row:my},{col:mx+2,row:my},{col:mx+3,row:my}];prevSnake=clone(snake);dir={x:-1,y:0};q=[];grow=0;stepGrew=false;crashDir={x:0,y:0};score=0;eaten=0;stepMs=132;frozen=0;pops=[];phase="playing";PSArcadeHost.hideCard();spawnFood("normal");stepStart=performance.now();syncHud();}'
    js .= 'function queueDir(nx,ny){if(phase!=="playing")return;const last=q.length?q[q.length-1]:dir;if((nx===-last.x&&ny===-last.y)||(nx===last.x&&ny===last.y))return;if(q.length<2)q.push({x:nx,y:ny});}'
    js .= 'function gameOver(reason){phase="gameover";prevSnake=clone(snake);stepGrew=false;crashDir={x:dir.x,y:dir.y};frozen=0.22;PSArcadeHost.showCard("GAME OVER",reason+" | Score "+score+" (Best "+hi+")","Retry (R)");syncHud();}'
    js .= 'function step(now){if(food&&food.ttl>0&&(now-food.born)>=food.ttl)spawnFood("normal");if(q.length)dir=q.shift();let nc=snake[0].col+dir.x,nr=snake[0].row+dir.y;'
    js .= 'if(nc<0||nc>=cols||nr<0||nr>=rows){if(wrapMode){nc=(nc+cols)%cols;nr=(nr+rows)%rows;}else{gameOver("Hit Arena Wall");return;}}'
    js .= 'const eat=food&&nc===food.col&&nr===food.row;const lim=(grow===0&&!eat)?snake.length-1:snake.length;'
    js .= 'for(let i=0;i<lim;i++){if(snake[i].col===nc&&snake[i].row===nr){gameOver("Self Collision");return;}}'
    js .= 'prevSnake=clone(snake);if(eat){score+=food.pts;eaten++;grow+=(food.kind==="bonus"?2:1);if(score>hi){hi=score;localStorage.setItem("ps_arcade_hi_snake",String(hi));}pops.push({x:(nc+0.5)*cell,y:(nr+0.5)*cell,t:"+"+food.pts,b:now,c:food.kind==="bonus"?"#fbbf24":"#6ee7b7"});stepMs=Math.max(68,132-Math.min(64,eaten*3));const nk=(eaten%5===0)?"bonus":"normal";food=null;snake.unshift({col:nc,row:nr});stepGrew=(grow>0);if(grow>0)grow--;else snake.pop();spawnFood(nk);syncHud();}else{snake.unshift({col:nc,row:nr});stepGrew=(grow>0);if(grow>0)grow--;else snake.pop();}}'
    js .= 'function buildPieces(t){const prev=(prevSnake&&prevSnake.length>=2)?prevSnake:snake;const lenC=snake.length,lenP=prev.length;if(!lenC)return[];const pieces=[];let extraTail=null;'
    js .= 'const pH=prev[0],cH=snake[0],dhc=Math.abs(cH.col-pH.col)+Math.abs(cH.row-pH.row);let skip2=false;'
    js .= 'if(dhc===0){const hx=cH.col+crashDir.x*t,hy=cH.row+crashDir.y*t;const hp=[{c:hx,r:hy}];if(Math.abs(hx-cH.col)>0.001||Math.abs(hy-cH.row)>0.001)hp.push({c:cH.col,r:cH.row});pieces.push(hp);}'
    js .= 'else if(dhc===1){pieces.push([{c:pH.col+(cH.col-pH.col)*t,r:pH.row+(cH.row-pH.row)*t}]);}'
    js .= 'else{const hSX=(cH.col===0&&pH.col===cols-1)?1:(cH.col===cols-1&&pH.col===0)?-1:0;const hSY=(cH.row===0&&pH.row===rows-1)?1:(cH.row===rows-1&&pH.row===0)?-1:0;'
    js .= 'if(t<0.5){pieces.push([{c:pH.col+hSX*t,r:pH.row+hSY*t}]);}else{pieces.push([{c:cH.col-hSX*(1-t),r:cH.row-hSY*(1-t)},{c:cH.col-hSX*0.5,r:cH.row-hSY*0.5}]);pieces.push([{c:pH.col+hSX*0.5,r:pH.row+hSY*0.5}]);}skip2=true;}'
    js .= 'for(let idx=1;idx<lenC;idx++){const cur=snake[idx],isLast=(idx===lenC-1);if(isLast&&!stepGrew&&lenP>=2)break;'
    js .= 'const prevSeg=snake[idx-1],curP=pieces[pieces.length-1],jmp=Math.abs(cur.col-prevSeg.col)+Math.abs(cur.row-prevSeg.row);'
    js .= 'if(jmp<=1||(idx===1&&skip2)){curP.push({c:cur.col,r:cur.row});}else{const jSX=(cur.col===0&&prevSeg.col===cols-1)?-1:(cur.col===cols-1&&prevSeg.col===0)?1:0;const jSY=(cur.row===0&&prevSeg.row===rows-1)?-1:(cur.row===rows-1&&prevSeg.row===0)?1:0;curP.push({c:prevSeg.col-jSX*0.5,r:prevSeg.row-jSY*0.5});pieces.push([{c:cur.col+jSX*0.5,r:cur.row+jSY*0.5},{c:cur.col,r:cur.row}]);}}'
    js .= 'if(!stepGrew&&lenP>=2&&lenC>=2){const pT=prev[lenP-1],cT=snake[lenC-1],befT=snake[lenC-2];let curP=pieces[pieces.length-1];'
    js .= 'const tJmp=Math.abs(cT.col-befT.col)+Math.abs(cT.row-befT.row);if(tJmp>1){const bSX=(cT.col===0&&befT.col===cols-1)?-1:(cT.col===cols-1&&befT.col===0)?1:0;const bSY=(cT.row===0&&befT.row===rows-1)?-1:(cT.row===rows-1&&befT.row===0)?1:0;curP.push({c:befT.col-bSX*0.5,r:befT.row-bSY*0.5});curP=[{c:cT.col+bSX*0.5,r:cT.row+bSY*0.5}];pieces.push(curP);}'
    js .= 'const dtc=Math.abs(cT.col-pT.col)+Math.abs(cT.row-pT.row);if(dtc<=1){curP.push({c:cT.col,r:cT.row});curP.push({c:pT.col+(cT.col-pT.col)*t,r:pT.row+(cT.row-pT.row)*t});}'
    js .= 'else{const tSX=(cT.col===0&&pT.col===cols-1)?1:(cT.col===cols-1&&pT.col===0)?-1:0;const tSY=(cT.row===0&&pT.row===rows-1)?1:(cT.row===rows-1&&pT.row===0)?-1:0;curP.push({c:cT.col,r:cT.row});if(t<0.5){curP.push({c:cT.col-tSX*0.5,r:cT.row-tSY*0.5});extraTail=[{c:pT.col+tSX*0.5,r:pT.row+tSY*0.5},{c:pT.col+tSX*t,r:pT.row+tSY*t}];}else{curP.push({c:cT.col-tSX*(1-t),r:cT.row-tSY*(1-t)});}}if(extraTail)pieces.push(extraTail);}'
    js .= 'return pieces;}'
    js .= 'function strokePieces(c2,pxP,lw,col){c2.strokeStyle=col;c2.lineWidth=lw;c2.lineCap="round";c2.lineJoin="round";pxP.forEach(pts=>{if(!pts.length)return;c2.beginPath();if(pts.length===1){c2.moveTo(pts[0].x,pts[0].y);c2.lineTo(pts[0].x+0.01,pts[0].y);}else{pts.forEach((p,i)=>i?c2.lineTo(p.x,p.y):c2.moveTo(p.x,p.y));}c2.stroke();});}'
    js .= 'function draw(now){const W=cvs.width,H=cvs.height;ctx.clearRect(0,0,W,H);'
    js .= 'ctx.save();if(wrapMode){ctx.setLineDash([7,6]);ctx.strokeStyle="rgba(245,158,11,0.58)";ctx.lineWidth=2;ctx.strokeRect(2,2,W-4,H-4);}else{ctx.strokeStyle="rgba(148,163,184,0.34)";ctx.lineWidth=2;ctx.strokeRect(2,2,W-4,H-4);const L=12;ctx.strokeStyle="#34d399";[[2,2,1,1],[W-2,2,-1,1],[2,H-2,1,-1],[W-2,H-2,-1,-1]].forEach(([bx,by,sx,sy])=>{ctx.beginPath();ctx.moveTo(bx+sx*L,by);ctx.lineTo(bx,by);ctx.lineTo(bx,by+sy*L);ctx.stroke();});}ctx.restore();'
    js .= 'if(food){const fx=(food.col+0.5)*cell,fy=(food.row+0.5)*cell,r=cell*0.34;ctx.save();if(food.kind==="bonus"){const rem=Math.max(0,1-(now-food.born)/food.ttl);const rot=now*0.0024,pls=1+0.08*Math.sin(now*0.01);ctx.fillStyle="#f59e0b";ctx.shadowColor="rgba(245,158,11,.65)";ctx.shadowBlur=10;ctx.beginPath();for(let k=0;k<16;k++){const rad=((k%2===0)?r*1.16:r*0.5)*pls;const ang=rot+k*Math.PI/8;if(k)ctx.lineTo(fx+Math.cos(ang)*rad,fy+Math.sin(ang)*rad);else ctx.moveTo(fx+Math.cos(ang)*rad,fy+Math.sin(ang)*rad);}ctx.closePath();ctx.fill();ctx.shadowBlur=0;ctx.strokeStyle="#fde68a";ctx.lineWidth=2;ctx.beginPath();ctx.arc(fx,fy,r*1.42,-Math.PI/2,-Math.PI/2+Math.PI*2*rem);ctx.stroke();}else{ctx.fillStyle="#ef4444";ctx.shadowColor="rgba(239,68,68,.55)";ctx.shadowBlur=8;const s=r*1.65;ctx.beginPath();ctx.roundRect(fx-s/2,fy-s/2,s,s,r*0.48);ctx.fill();}ctx.restore();}'
    js .= 'const t=phase==="playing"?Math.min(1,Math.max(0,(now-stepStart)/stepMs)):(phase==="gameover"?frozen:0);'
    js .= 'const rawPieces=buildPieces(t);const pxPieces=[];let headPx=null;'
    js .= 'rawPieces.forEach((pc,pi)=>{const arr=[];pc.forEach(pt=>{const x=(pt.c+0.5)*cell,y=(pt.r+0.5)*cell;if(!arr.length||Math.abs(x-arr[arr.length-1].x)>0.35||Math.abs(y-arr[arr.length-1].y)>0.35)arr.push({x,y});});if(arr.length){if(pi===0)headPx=arr[0];pxPieces.push(arr);}});'
    js .= 'if(pxPieces.length){if(snkBuf.width!==W||snkBuf.height!==H){snkBuf.width=W;snkBuf.height=H;}bctx.clearRect(0,0,W,H);const tubeW=cell*0.68,rimW=Math.max(1.5,cell*0.075);'
    js .= 'const rimCol=phase==="gameover"?"#fca5a5":"#6ee7b7",fillCol=phase==="gameover"?"#ef4444":"#10b981";'
    js .= 'strokePieces(bctx,pxPieces,tubeW+rimW*2,rimCol);strokePieces(bctx,pxPieces,tubeW,fillCol);strokePieces(bctx,pxPieces,tubeW*0.26,"rgba(255,255,255,0.22)");'
