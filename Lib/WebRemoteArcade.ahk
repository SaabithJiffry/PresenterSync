    js .= 'function rotate(dir){if(phase!=="playing")return false;if(curKind==="O")return true;const o=curRot&3,nr=(o+(dir>0?1:3))&3,ks=(curKind==="I"?KI:KJ)[o+">"+nr];for(let i=0;i<ks.length;i++){const nx=curX+ks[i][0],ny=curY+ks[i][1];if(fits(curKind,nx,ny,nr)){curX=nx;curY=ny;curRot=nr;lastRot=true;rstLock();return true;}}return false;}'
    js .= 'function doHold(){if(phase!=="playing"||holdUsed)return false;const p=holdKind;holdKind=curKind;holdUsed=true;if(!p)spawnNext();else spawnKind(p);syncHud();return true;}'
