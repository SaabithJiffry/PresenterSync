    js .= 'const KI={"0>1":[[0,0],[-2,0],[1,0],[-2,1],[1,-2]],"1>0":[[0,0],[2,0],[-1,0],[2,-1],[-1,2]],"1>2":[[0,0],[-1,0],[2,0],[-1,-2],[2,1]],"2>1":[[0,0],[1,0],[-2,0],[1,2],[-2,-1]],"2>3":[[0,0],[2,0],[-1,0],[2,-1],[-1,2]],"3>2":[[0,0],[-2,0],[1,0],[-2,1],[1,-2]],"3>0":[[0,0],[1,0],[-2,0],[1,2],[-2,-1]],"0>3":[[0,0],[-1,0],[2,0],[-1,-2],[2,1]]};'
    js .= 'function syncHud(){PSArcadeHost.setHud(score,hi,"LVL "+level+" · LINES "+lines,"Hold (C)",phase==="paused"?"Resume (P)":"Pause (P)",false);}'
    js .= 'function size(){W=Math.min(540,Math.max(320,window.innerWidth-24));H=Math.min(540,Math.max(360,Math.floor(window.innerHeight*0.74)));cvs.width=W;cvs.height=H;}'
    js .= 'function refillBag(){const a=["I","O","T","S","Z","J","L"];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));const t=a[i];a[i]=a[j];a[j]=t;}bag.push(...a);}'
