#Requires AutoHotkey v2.0

BuildWebRemoteHtml(appVersion := "", activePort := 4456) {
    verEsc := String(appVersion)
    verEsc := StrReplace(verEsc, "&", "&amp;")
    verEsc := StrReplace(verEsc, "<", "&lt;")
    verEsc := StrReplace(verEsc, ">", "&gt;")
    verEsc := StrReplace(verEsc, '"', "&quot;")
    verEsc := StrReplace(verEsc, "'", "&#39;")
    portNum := IsInteger(activePort) ? Integer(activePort) : 4456

    svgFavicon := "data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 64 64%27%3E"
        . "%3Crect width=%2764%27 height=%2764%27 rx=%2716%27 fill=%27%23107c10%27/%3E"
        . "%3Crect x=%2724%27 y=%2712%27 width=%2716%27 height=%2724%27 rx=%278%27 fill=%27%23fff%27/%3E"
        . "%3Cpath d=%27M18 30a14 14 0 0 0 28 0M32 44v9M23 53h18%27 stroke=%27%23fff%27 stroke-width=%274.5%27 fill=%27none%27 stroke-linecap=%27round%27/%3E"
        . "%3C/svg%3E"

    html := '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">'
        . '<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">'
        . '<title>PresenterSync Web Remote</title>'
        . '<link rel="icon" type="image/x-icon" href="/favicon.ico">'
        . '<link rel="icon" type="image/svg+xml" href="' svgFavicon '">'
        . '<link rel="apple-touch-icon" href="/favicon.ico">'
        . '<style>'
        . ':root{--bg:#090b10;--card:#131722;--bd:#252c3d;--tx:#f1f5f9;--mu:#94a3b8;--live:#107c10;--muted:#c42b1c;--warn:#f59e0b;--acc:#0067c0;--ui-scale:1}'
        . '*{box-sizing:border-box;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}'
        . 'body{margin:0;background:var(--bg);color:var(--tx);padding:14px;display:flex;justify-content:center;touch-action:manipulation;overflow-x:hidden}'
        . '.wrap{width:100%;max-width:min(100%,calc(560px * var(--ui-scale,1)));display:flex;flex-direction:column;gap:calc(12px * var(--ui-scale,1))}'
        . '.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:calc(14px * var(--ui-scale,1))}'
        . '.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}'
        . '.hdr{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:12px;color:var(--mu);flex-wrap:wrap}'
        . '.hdrActs{display:flex;gap:6px;align-items:center;flex-wrap:wrap}'
        . '.pill{width:100%;border:2px solid rgba(255,255,255,.2);border-radius:16px;padding:calc(24px * var(--ui-scale,1)) calc(16px * var(--ui-scale,1));color:#fff;font-size:calc(26px * var(--ui-scale,1));font-weight:800;letter-spacing:1px;cursor:pointer;text-align:center;touch-action:manipulation;user-select:none}'
        . '.pill.live{background:var(--live)}.pill.muted{background:var(--muted)}.pill.warn{border-color:var(--warn)}'
        . '.sub{font-size:calc(12px * var(--ui-scale,1));font-weight:600;opacity:.9;margin-top:4px}'
        . 'button{border:1px solid var(--bd);background:#1e2433;color:var(--tx);border-radius:10px;padding:calc(10px * var(--ui-scale,1)) calc(12px * var(--ui-scale,1));font-size:calc(13px * var(--ui-scale,1));font-weight:700;cursor:pointer;touch-action:manipulation}'
        . 'button.sm{padding:5px 10px;font-size:11px;border-radius:8px}'
        . 'button.pri{background:var(--acc);border-color:var(--acc);color:#fff;width:100%}'
        . 'button.act{background:var(--acc);border-color:var(--acc);color:#fff}'
        . 'button.brb{background:#d97706;border-color:#d97706;color:#fff}'
        . 'button.dng{background:#7f1d1d;border-color:#b91c1c;color:#fecaca}'
        . 'button.grow{flex:1 1 0}'
        . 'input{flex:1;min-width:120px;background:#0c1018;border:1px solid var(--bd);color:var(--tx);border-radius:10px;padding:10px 12px;font-size:14px}'
        . '.notes{background:#0b0e15;border:1px solid var(--bd);border-radius:10px;padding:10px;font-size:13px;line-height:1.45;min-height:64px;max-height:150px;overflow:auto;white-space:pre-wrap;color:#cbd5e1}'
        . '.badge{font-size:11px;font-weight:700;padding:3px 8px;border-radius:999px;background:#1e293b;color:#cbd5e1}'
        . '.badge.rec{background:#dc2626;color:#fff}.badge.warn{background:#d97706;color:#fff}.badge.ok{background:#065f46;color:#d1fae5}'
        . '.modalBg{position:fixed;inset:0;background:rgba(4,6,10,.78);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:16px;z-index:200}'
        . '.modalCard{width:100%;max-width:440px;background:#111622;border:1px solid #2b354b;border-radius:16px;padding:18px;box-shadow:0 20px 50px rgba(0,0,0,.6);display:flex;flex-direction:column;gap:12px}'
        . '.modalHdr{display:flex;align-items:center;justify-content:space-between;gap:10px}'
        . '.modalBrand{display:flex;align-items:center;gap:10px}'
        . '.modalLogo{width:34px;height:34px;border-radius:10px;background:#107c10;display:flex;align-items:center;justify-content:center;font-weight:800;color:#fff;flex-shrink:0}'
        . '.modalLinks{display:flex;gap:8px;flex-wrap:wrap}'
        . 'a.linkBtn{flex:1 1 0;text-align:center;text-decoration:none;border:1px solid var(--bd);background:#1a2234;color:#93c5fd;border-radius:10px;padding:9px 10px;font-size:12px;font-weight:700}'
        . 'a.linkBtn:hover{border-color:#60a5fa;background:#1e293b}'
        . '.vaultFooter{font-size:11px;font-family:ui-monospace,Consolas,monospace;color:#64748b;border-top:1px solid #1e2638;padding-top:10px;display:flex;justify-content:space-between;align-items:center;gap:8px}'
        . '.snkOverlay{position:fixed;inset:0;z-index:9999;background:rgba(9,11,16,0.72);backdrop-filter:blur(6px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:12px;user-select:none;touch-action:none}'
        . '.snkHud{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:center;background:rgba(19,23,34,0.88);border:1px solid rgba(255,255,255,0.14);border-radius:999px;padding:6px 12px;font-size:12px;box-shadow:0 8px 28px rgba(0,0,0,.45)}'
        . '.snkHud b{color:#34d399;letter-spacing:.6px}'
        . '.snkCanvas{border-radius:14px;background:rgba(12,15,23,0.45);box-shadow:0 16px 48px rgba(0,0,0,.55);max-width:100%;max-height:76vh}'
        . '.snkCard{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);min-width:250px;max-width:90vw;background:rgba(17,22,34,0.94);border:1px solid rgba(255,255,255,.16);border-radius:16px;padding:18px;text-align:center;box-shadow:0 18px 50px rgba(0,0,0,.65);display:flex;flex-direction:column;gap:10px;z-index:10000}'
        . '.snkDpad{display:grid;grid-template-columns:repeat(3,48px);grid-template-rows:repeat(2,44px);gap:6px;margin-top:4px}'
        . '.snkDpad button{padding:0;font-size:16px;border-radius:10px;background:rgba(30,36,51,.85)}'
        . '.hide{display:none!important}'
        . '</style></head><body><div class="wrap">'
        . '<div class="hdr">'
        . '<span><b>PresenterSync Web Remote</b>' (verEsc != "" ? ' v<span id="hdrVer">' verEsc '</span>' : "") ' (:' portNum ')</span>'
        . '<div class="hdrActs">'
        . '<span id="st" class="badge">Disconnected</span>'
        . '<button id="scaleBtn" type="button" class="sm" title="UI Scale">1.0x</button>'
        . '<button id="aboutBtn" type="button" class="sm">About</button>'
        . '<button id="discBtn" type="button" class="sm dng hide">Disconnect</button>'
        . '</div></div>'
        . '<div id="authCard" class="card"><div style="font-weight:700;margin-bottom:8px">Enter 6-Char Session Code</div>'
        . '<div class="row"><input id="codeIn" maxlength="12" placeholder="e.g. ABC-123" autocomplete="off"><button id="connBtn" type="button" class="act">Connect</button></div>'
        . '<div id="authErr" style="color:#f87171;font-size:12px;margin-top:8px"></div></div>'
        . '<div id="deck" class="hide" style="display:flex;flex-direction:column;gap:12px">'
        . '<button id="micBtn" type="button" class="pill live" data-cmd="toggle_mute"><span id="micLbl">MIC LIVE</span><div id="micSub" class="sub">Tap to mute</div></button>'
        . '<div class="row"><span id="recBadge" class="badge">REC: OFF</span><span id="warnBadge" class="badge warn hide">MIC SIGNAL WHILE MUTED</span></div>'
        . '<button id="transBtn" type="button" class="pri" data-cmd="transition_scene">&#8644; OBS Transition (Preview &#8596; Program) &bull; <span id="scName">Scene</span></button>'
        . '<div class="card"><div class="hdr" style="margin-bottom:8px"><b id="slNum">Slideshow</b><span id="slTitle"></span></div>'
        . '<div class="row" style="margin-bottom:8px">'
        . '<button type="button" class="grow" data-cmd="ppt_prev">&#9664; Prev</button>'
        . '<button type="button" class="grow" data-cmd="ppt_next">Next &#9654;</button>'
        . '<button type="button" class="grow" data-cmd="slide_start">Start (F5)</button>'
        . '</div>'
        . '<div id="slNotes" class="notes">No speaker notes.</div></div>'
        . '<div class="card"><div class="hdr" style="margin-bottom:8px"><b>Scenes</b></div><div id="scenes" class="row"></div></div>'
        . '<div class="card"><div class="hdr" style="margin-bottom:8px"><b id="tmrTxt">Timer: 10:00 (stopped)</b><button id="brbBtn" type="button" data-cmd="toggle_standby">BRB</button></div>'
        . '<div class="row">'
        . '<button type="button" class="grow" data-timer="timer_start" data-dur="300">5m</button>'
        . '<button type="button" class="grow" data-timer="timer_start" data-dur="600">10m</button>'
        . '<button type="button" class="grow" data-timer="timer_start" data-dur="900">15m</button>'
        . '<button type="button" class="grow" data-timer="timer_pause" data-dur="0">Pause</button>'
        . '<button type="button" class="grow" data-timer="timer_reset" data-dur="0">Reset</button>'
        . '</div></div>'
        . '<div class="card"><div class="hdr" style="margin-bottom:8px"><b>Stage Nudge</b></div>'
        . '<div class="row" id="nudgeChips" style="margin-bottom:8px">'
        . '<button type="button" class="grow" data-nudge="2 min left">2 min left</button>'
        . '<button type="button" class="grow" data-nudge="Wrap up">Wrap up</button>'
        . '<button type="button" class="grow" data-nudge="Q&amp;A">Q&amp;A</button>'
        . '</div>'
        . '<div class="row"><input id="nudgeIn" placeholder="Custom stage message..."><button id="nudgeSendBtn" type="button" class="act">Send</button></div></div>'
        . '</div></div>'
        . '<div id="aboutModal" class="modalBg hide" role="dialog" aria-modal="true" aria-labelledby="aboutTitle">'
        . '<div class="modalCard">'
        . '<div class="modalHdr"><div class="modalBrand">'
        . '<div class="modalLogo" id="aboutLogo">PS</div>'
        . '<div><div id="aboutTitle" style="font-weight:800;font-size:15px">PresenterSync Web Remote</div>'
        . '<div style="font-size:12px;color:#60a5fa;font-weight:700" id="aboutVer">Version ' (verEsc != "" ? verEsc : "0.0.0") ' &bull; Companion Client</div></div>'
        . '</div><button id="aboutCloseBtn" type="button" class="sm" aria-label="Close About">Close</button></div>'
        . '<div style="font-size:12.5px;line-height:1.5;color:#cbd5e1">'
        . '<b>Created by Saabith Jiffry</b><br>'
        . 'Zero-install browser companion connected directly to your PresenterSync Primary Host Bridge. Controls microphone mute state, OBS scene transitions, PowerPoint navigation with live speaker notes, presenter countdown timer, and instant stage nudges.'
        . '</div>'
        . '<div class="modalLinks">'
        . '<a class="linkBtn" href="https://github.com/SaabithJiffry/PresenterSync" target="_blank" rel="noopener noreferrer">GitHub Repository</a>'
        . '<a class="linkBtn" href="https://github.com/SaabithJiffry/PresenterSync/releases/latest" target="_blank" rel="noopener noreferrer">Updates &amp; Release Notes</a>'
        . '</div>'
        . '<div id="vaultFooter" class="vaultFooter"><span>PresenterSync Bridge :' portNum '</span><span id="vaultSlotBadge">SECURE SESSION</span></div>'
        . '<div id="vaultDrawerSlot" class="hide"></div>'
        . '</div></div>'
        . '<div id="snkWrap" class="snkOverlay hide" role="dialog" aria-label="Snake Overlay">'
        . '<div class="snkHud">'
        . '<b>SNAKE</b>'
        . '<span>SCORE <b id="snkScore">0</b></span>'
        . '<span>BEST <b id="snkBest">0</b></span>'
        . '<button id="snkModeBtn" type="button" class="sm">WALLS (E)</button>'
        . '<button id="snkPauseBtn" type="button" class="sm">Pause (P)</button>'
        . '<button id="snkPadToggle" type="button" class="sm">D-Pad</button>'
        . '<button id="snkCloseBtn" type="button" class="sm dng">Exit (Esc)</button>'
        . '</div>'
        . '<canvas id="snkCanvas" class="snkCanvas"></canvas>'
        . '<div id="snkDpad" class="snkDpad hide">'
        . '<div></div><button type="button" data-sdir="0,-1">&#9650;</button><div></div>'
        . '<button type="button" data-sdir="-1,0">&#9664;</button><button type="button" data-sdir="0,1">&#9660;</button><button type="button" data-sdir="1,0">&#9654;</button>'
        . '</div>'
        . '<div id="snkCard" class="snkCard hide">'
        . '<div id="snkCardTitle" style="font-size:18px;font-weight:800">PAUSED</div>'
        . '<div id="snkCardSub" style="font-size:12.5px;color:#94a3b8">Press Space or tap Resume</div>'
        . '<div class="row" style="justify-content:center">'
        . '<button id="snkActBtn" type="button" class="act grow">Resume</button>'
        . '<button id="snkCardExit" type="button" class="dng">Exit</button>'
        . '</div></div></div>'
        . '<script>'
        . 'const qs=id=>document.getElementById(id);'
        . 'let ws=null,pingT=null,manualDisconnect=false;'
        . 'let devId=localStorage.getItem("ps_web_device_id");'
        . 'if(!devId){devId="web-"+Math.random().toString(36).slice(2,10);localStorage.setItem("ps_web_device_id",devId);}'
        . 'let tok=localStorage.getItem("ps_web_token")||"";'
        . 'function sendJson(o){if(ws&&ws.readyState===1)ws.send(JSON.stringify(o));}'
        . 'function sendCmd(t){sendJson({type:t,deviceId:devId,source:"web_remote"});}'
        . 'function sendTimer(t,d){sendJson({type:t,durationSec:d,deviceId:devId,source:"web_remote"});}'
        . 'function sendNudge(m){if(m)sendJson({type:"stage_nudge",message:m,sender:"Web Remote",deviceId:devId});}'
        . 'function sendCustomNudge(){const inp=qs("nudgeIn");const v=inp.value.trim();if(v){sendNudge(v);inp.value="";}}'
        . 'function fmtTime(s){const neg=s<0;const a=Math.abs(s|0);return(neg?"-":"")+String(Math.floor(a/60)).padStart(2,"0")+":"+String(a%60).padStart(2,"0");}'
        . 'function resetToAuth(statusText,errText){'
        . 'if(pingT){clearInterval(pingT);pingT=null;}'
        . 'qs("st").textContent=statusText||"Disconnected";qs("st").className="badge";'
        . 'qs("deck").classList.add("hide");qs("discBtn").classList.add("hide");qs("authCard").classList.remove("hide");'
        . 'if(typeof errText==="string")qs("authErr").textContent=errText;'
        . '}'
        . 'function cleanDisconnect(){'
        . 'manualDisconnect=true;tok="";localStorage.removeItem("ps_web_token");'
        . 'if(ws&&ws.readyState===1){try{ws.send(JSON.stringify({type:"disconnect",deviceId:devId,source:"web_remote"}));}catch(_){}}'
        . 'if(ws){try{ws.close(1000,"user_disconnect");}catch(_){}ws=null;}'
        . 'resetToAuth("Disconnected","");'
        . '}'
        . 'function renderState(m){'
        . 'const btn=qs("micBtn"),lbl=qs("micLbl"),sub=qs("micSub"),wb=qs("warnBadge");'
        . 'btn.className="pill "+(m.isMuted?"muted":"live")+(m.isMuted&&m.voiceWhileMuted?" warn":"");'
        . 'lbl.textContent=m.isMuted?"MIC MUTED":"MIC LIVE";'
        . 'sub.textContent=m.isMuted?"Tap to unmute":"Tap to mute";'
        . 'wb.classList.toggle("hide",!(m.isMuted&&m.voiceWhileMuted));'
        . 'const rb=qs("recBadge");'
        . 'rb.textContent=m.recState===1?"REC "+fmtTime(m.recSeconds||0):(m.recState===2?"PAUSED "+fmtTime(m.recSeconds||0):"REC: OFF");'
        . 'rb.className="badge"+(m.recState===1?" rec":"");'
        . 'qs("scName").textContent=m.activeScene||"Scene";'
        . 'qs("slNum").textContent=(m.slideIndex>0)?("Slide "+m.slideIndex+(m.slideTotal>0?" / "+m.slideTotal:"")):"Slideshow";'
        . 'qs("slTitle").textContent=m.slideTitle||"";'
        . 'qs("slNotes").textContent=m.slideNotes||"No speaker notes.";'
        . 'const brb=qs("brbBtn");brb.textContent=m.isStandby?"BRB ON":"BRB";brb.className=m.isStandby?"brb":"";'
        . 'qs("tmrTxt").textContent="Timer: "+fmtTime(m.timerRemainingSec||0)+" ("+(m.timerState||"stopped")+")";'
        . 'const scBox=qs("scenes");scBox.innerHTML="";'
        . '(m.scenes||[]).forEach(s=>{const b=document.createElement("button");b.type="button";b.textContent=s;if(s===m.activeScene)b.className="act";b.addEventListener("click",()=>sendJson({type:"switch_scene",sceneName:s,deviceId:devId,source:"web_remote"}));scBox.appendChild(b);});'
        . '}'
        . 'function connectWs(codeVal){'
        . 'manualDisconnect=false;'
        . 'if(ws){try{ws.close()}catch(_){}}if(pingT){clearInterval(pingT);pingT=null;}'
        . 'qs("authErr").textContent="";qs("st").textContent="Connecting...";qs("st").className="badge";'
        . 'const proto=location.protocol==="https:"?"wss://":"ws://";'
        . 'ws=new WebSocket(proto+location.host+"/ws");'
        . 'ws.onopen=()=>sendJson({type:"auth",code:codeVal,token:tok,deviceId:devId,deviceName:"Web Remote",platform:"Web"});'
        . 'ws.onmessage=ev=>{let m;try{m=JSON.parse(ev.data)}catch(_){return;}'
        . 'if(m.type==="auth_ok"){if(m.sessionToken){tok=m.sessionToken;localStorage.setItem("ps_web_token",tok);}qs("st").textContent="Connected";qs("st").className="badge ok";qs("authCard").classList.add("hide");qs("deck").classList.remove("hide");qs("discBtn").classList.remove("hide");pingT=setInterval(()=>sendJson({type:"ping"}),20000);}'
        . 'else if(m.type==="auth_error"){tok="";localStorage.removeItem("ps_web_token");resetToAuth("Auth Failed",m.error||"Auth failed");}'
        . 'else if(m.type==="disconnected"){cleanDisconnect();}'
        . 'else if(m.type==="mute_state"||m.type==="sync_resync"){renderState(m);}'
        . 'else if(m.type==="ping"){sendJson({type:"pong",timestamp:Date.now()});}'
        . '};'
        . 'ws.onclose=()=>{if(pingT){clearInterval(pingT);pingT=null;}ws=null;if(manualDisconnect){resetToAuth("Disconnected","");}else{qs("st").textContent="Disconnected";qs("st").className="badge";}};'
        . '}'
        . 'document.querySelectorAll("[data-cmd]").forEach(b=>b.addEventListener("click",()=>sendCmd(b.dataset.cmd)));'
        . 'document.querySelectorAll("[data-timer]").forEach(b=>b.addEventListener("click",()=>sendTimer(b.dataset.timer,parseInt(b.dataset.dur||"0",10)||0)));'
        . 'document.querySelectorAll("[data-nudge]").forEach(b=>b.addEventListener("click",()=>sendNudge(b.dataset.nudge)));'
        . 'qs("nudgeSendBtn").addEventListener("click",sendCustomNudge);'
        . 'qs("nudgeIn").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();sendCustomNudge();}});'
        . 'qs("connBtn").addEventListener("click",()=>{const c=qs("codeIn").value.trim().toUpperCase();connectWs(c);});'
        . 'qs("codeIn").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();qs("connBtn").click();}});'
        . 'qs("discBtn").addEventListener("click",cleanDisconnect);'
        . 'qs("aboutBtn").addEventListener("click",()=>qs("aboutModal").classList.remove("hide"));'
        . 'qs("aboutCloseBtn").addEventListener("click",()=>qs("aboutModal").classList.add("hide"));'
        . 'qs("aboutModal").addEventListener("click",e=>{if(e.target===qs("aboutModal"))qs("aboutModal").classList.add("hide");});'
        . 'document.addEventListener("keydown",e=>{if(e.key==="Escape"&&!qs("aboutModal").classList.contains("hide"))qs("aboutModal").classList.add("hide");});'
        . 'const WEB_SCALES=[0.85,1,1.25,1.5];'
        . 'let webScale=parseFloat(localStorage.getItem("ps_web_scale")||"1");'
        . 'if(!WEB_SCALES.includes(webScale))webScale=1;'
        . 'function applyWebScale(s){webScale=s;document.documentElement.style.setProperty("--ui-scale",String(s));const sb=qs("scaleBtn");if(sb)sb.textContent=(s===1?"1.0":String(s))+"x";localStorage.setItem("ps_web_scale",String(s));}'
        . 'applyWebScale(webScale);'
        . 'qs("scaleBtn").addEventListener("click",()=>{const i=WEB_SCALES.indexOf(webScale);applyWebScale(WEB_SCALES[(i+1)%WEB_SCALES.length]);});'
        . 'const PSWebSnake=(()=>{const cvs=qs("snkCanvas"),ctx=cvs.getContext("2d"),wrap=qs("snkWrap"),card=qs("snkCard");'
        . 'let active=false,phase="idle",cols=24,rows=18,cell=20,raf=0,snake=[],prevSnake=[],dir={x:-1,y:0},q=[],grow=0,score=0,eaten=0,wrapMode=false,stepMs=132,stepStart=0,frozen=0,food=null,pops=[],touch0=null;'
        . 'let hi=parseInt(localStorage.getItem("ps_arcade_hi_snake")||"0",10)||0;'
        . 'function size(){const mw=Math.min(640,window.innerWidth-28),mh=Math.min(460,window.innerHeight-180);cell=Math.max(14,Math.min(26,Math.floor(Math.min(mw/cols,mh/rows))));cvs.width=cols*cell;cvs.height=rows*cell;}'
        . 'function clone(a){return a.map(p=>({col:p.col,row:p.row}));}'
        . 'function spawnFood(kind){const used=new Set(snake.map(s=>s.col+","+s.row));const free=[];for(let c=0;c<cols;c++)for(let r=0;r<rows;r++)if(!used.has(c+","+r))free.push({c,r});'
