#Requires AutoHotkey v2.0

BuildWebRemoteHtml(appVersion := "", activePort := 4456) {
    verEsc := String(appVersion)
    verEsc := StrReplace(verEsc, "&", "&amp;")
    verEsc := StrReplace(verEsc, "<", "&lt;")
    verEsc := StrReplace(verEsc, ">", "&gt;")
    verEsc := StrReplace(verEsc, '"', "&quot;")
    verEsc := StrReplace(verEsc, "'", "&#39;")
    portNum := IsInteger(activePort) ? Integer(activePort) : 4456

    svgFavicon := "data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 64 64%27%3E"
        . "%3Crect width=%2764%27 height=%2764%27 rx=%2716%27 fill=%27%23107c10%27/%3E"
        . "%3Crect x=%2724%27 y=%2712%27 width=%2716%27 height=%2724%27 rx=%278%27 fill=%27%23fff%27/%3E"
        . "%3Cpath d=%27M18 30a14 14 0 0 0 28 0M32 44v9M23 53h18%27 stroke=%27%23fff%27 stroke-width=%274.5%27 fill=%27none%27 stroke-linecap=%27round%27/%3E"
        . "%3C/svg%3E"

    html := '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">'
        . '<!-- SECTOR Z // DIAGNOSTIC BUS: 0 CREDITS -->'
        . '<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">'
