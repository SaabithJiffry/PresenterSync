        . '<link rel="icon" type="image/svg+xml" href="' svgFavicon '">'
        . '<link rel="apple-touch-icon" href="/favicon.ico">'
        . '<style>'
        . ':root{--bg:#090b10;--card:#131722;--bd:#252c3d;--tx:#f1f5f9;--mu:#94a3b8;--live:#107c10;--muted:#c42b1c;--warn:#f59e0b;--acc:#0067c0;--ui-scale:1}'
        . '*{box-sizing:border-box;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}'
        . 'body{margin:0;background:var(--bg);color:var(--tx);padding:14px;display:flex;justify-content:center;touch-action:manipulation;overflow-x:hidden}'
        . '.wrap{width:100%;max-width:min(100%,calc(560px * var(--ui-scale,1)));display:flex;flex-direction:column;gap:calc(12px * var(--ui-scale,1))}'
        . '.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:calc(14px * var(--ui-scale,1))}'
        . '.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}'
        . '.hdr{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:12px;color:var(--mu);flex-wrap:wrap}'
        . '.hdrActs{display:flex;gap:6px;align-items:center;flex-wrap:wrap}'
        . '.pill{width:100%;border:2px solid rgba(255,255,255,.2);border-radius:16px;padding:calc(24px * var(--ui-scale,1)) calc(16px * var(--ui-scale,1));color:#fff;font-size:calc(26px * var(--ui-scale,1));font-weight:800;letter-spacing:1px;cursor:pointer;text-align:center;touch-action:manipulation;user-select:none;-webkit-user-select:none;-webkit-tap-highlight-color:transparent}'
        . '.pill.live{background:var(--live)}.pill.muted{background:var(--muted)}.pill.warn{border-color:var(--warn)}'
        . '.sub{font-size:calc(12px * var(--ui-scale,1));font-weight:600;opacity:.9;margin-top:4px}'
        . 'button{border:1px solid var(--bd);background:#1e2433;color:var(--tx);border-radius:10px;padding:calc(10px * var(--ui-scale,1)) calc(12px * var(--ui-scale,1));font-size:calc(13px * var(--ui-scale,1));font-weight:700;cursor:pointer;touch-action:manipulation;user-select:none;-webkit-user-select:none;-webkit-tap-highlight-color:transparent}'
        . 'button.sm{min-height:44px;min-width:44px;padding:6px 12px;font-size:12px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center}'
        . 'button.pri{background:var(--acc);border-color:var(--acc);color:#fff;width:100%}'
        . 'button.act{background:var(--acc);border-color:var(--acc);color:#fff}'
        . 'button.brb{background:#d97706;border-color:#d97706;color:#fff}'
        . 'button.dng{background:#7f1d1d;border-color:#b91c1c;color:#fecaca}'
        . 'button.grow{flex:1 1 0}'
        . 'input{flex:1;min-width:120px;background:#0c1018;border:1px solid var(--bd);color:var(--tx);border-radius:10px;padding:10px 12px;font-size:14px}'
        . '.notes{background:#0b0e15;border:1px solid var(--bd);border-radius:10px;padding:10px;font-size:13px;line-height:1.45;min-height:64px;max-height:150px;overflow:auto;white-space:pre-wrap;color:#cbd5e1}'
        . '.badge{font-size:11px;font-weight:700;padding:3px 8px;border-radius:999px;background:#1e293b;color:#cbd5e1}'
        . '.badge.rec{background:#dc2626;color:#fff}.badge.warn{background:#d97706;color:#fff}.badge.ok{background:#065f46;color:#d1fae5}'
        . '.modalBg{position:fixed;inset:0;background:rgba(4,6,10,.78);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:16px;z-index:200}'
        . '.modalCard{width:100%;max-width:440px;background:#111622;border:1px solid #2b354b;border-radius:16px;padding:18px;box-shadow:0 20px 50px rgba(0,0,0,.6);display:flex;flex-direction:column;gap:12px}'
        . '.modalHdr{display:flex;align-items:center;justify-content:space-between;gap:10px}'
        . '.modalBrand{display:flex;align-items:center;gap:10px}'
        . '.modalLogo{width:34px;height:34px;border-radius:10px;background:#107c10;display:flex;align-items:center;justify-content:center;font-weight:800;color:#fff;flex-shrink:0}'
        . '.modalLinks{display:flex;gap:8px;flex-wrap:wrap}'
        . 'a.linkBtn{flex:1 1 0;text-align:center;text-decoration:none;border:1px solid var(--bd);background:#1a2234;color:#93c5fd;border-radius:10px;padding:9px 10px;font-size:12px;font-weight:700}'
        . 'a.linkBtn:hover{border-color:#60a5fa;background:#1e293b}'
        . '.vaultFooter{font-size:11px;font-family:ui-monospace,Consolas,monospace;color:#64748b;border-top:1px solid #1e2638;padding-top:10px;display:flex;justify-content:space-between;align-items:center;gap:8px}'
        . '.hide{display:none!important}'
        . '</style></head><body><div class="wrap">'
        . '<div class="hdr">'
        . '<span><b>PresenterSync Web Remote</b>' (verEsc != "" ? ' v<span id="hdrVer">' verEsc '</span>' : "") ' (:' portNum ')</span>'
        . '<div class="hdrActs">'
        . '<span id="st" class="badge">Disconnected</span>'
        . '<button id="scaleBtn" type="button" class="sm" title="UI Scale">1.0x</button>'
        . '<button id="aboutBtn" type="button" class="sm">About</button>'
        . '<button id="discBtn" type="button" class="sm dng hide">Disconnect</button>'
        . '</div></div>'
        . '<div id="authCard" class="card"><div style="font-weight:700;margin-bottom:8px">Enter 6-Char Session Code</div>'
        . '<div class="row"><input id="codeIn" maxlength="12" placeholder="e.g. ABC-123" autocomplete="off"><button id="connBtn" type="button" class="act">Connect</button></div>'
        . '<div id="authErr" style="color:#f87171;font-size:12px;margin-top:8px"></div></div>'
        . '<div id="deck" class="hide" style="display:flex;flex-direction:column;gap:12px">'
        . '<button id="micBtn" type="button" class="pill live" data-cmd="toggle_mute"><span id="micLbl">MIC LIVE</span><div id="micSub" class="sub">Tap to mute</div></button>'
        . '<div class="row"><span id="recBadge" class="badge">REC: OFF</span><span id="warnBadge" class="badge warn hide">MIC SIGNAL WHILE MUTED</span></div>'
        . '<button id="transBtn" type="button" class="pri" data-cmd="transition_scene">&#8644; OBS Transition (Preview &#8596; Program) &bull; <span id="scName">Scene</span></button>'
        . '<div class="card"><div class="hdr" style="margin-bottom:8px"><b id="slNum">Slideshow</b><span id="slTitle"></span></div>'
        . '<div class="row" style="margin-bottom:8px">'
        . '<button type="button" class="grow" data-cmd="ppt_prev">&#9664; Prev</button>'
        . '<button type="button" class="grow" data-cmd="ppt_next">Next &#9654;</button>'
        . '<button type="button" class="grow" data-cmd="slide_start">Start (F5)</button>'
        . '</div>'
        . '<div id="slNotes" class="notes">No speaker notes.</div></div>'
        . '<div class="card"><div class="hdr" style="margin-bottom:8px"><b>Scenes</b></div><div id="scenes" class="row"></div></div>'
        . '<div class="card"><div class="hdr" style="margin-bottom:8px"><b id="tmrTxt">Timer: 10:00 (stopped)</b><button id="brbBtn" type="button" data-cmd="toggle_standby">BRB</button></div>'
        . '<div class="row">'
        . '<button type="button" class="grow" data-timer="timer_start" data-dur="300">5m</button>'
        . '<button type="button" class="grow" data-timer="timer_start" data-dur="600">10m</button>'
        . '<button type="button" class="grow" data-timer="timer_start" data-dur="900">15m</button>'
        . '<button type="button" class="grow" data-timer="timer_pause" data-dur="0">Pause</button>'
        . '<button type="button" class="grow" data-timer="timer_reset" data-dur="0">Reset</button>'
        . '</div></div>'
        . '<div class="card"><div class="hdr" style="margin-bottom:8px"><b>Stage Nudge</b></div>'
        . '<div class="row" id="nudgeChips" style="margin-bottom:8px">'
        . '<button type="button" class="grow" data-nudge="2 min left">2 min left</button>'
        . '<button type="button" class="grow" data-nudge="Wrap up">Wrap up</button>'
        . '<button type="button" class="grow" data-nudge="Q&amp;A">Q&amp;A</button>'
        . '</div>'
        . '<div class="row"><input id="nudgeIn" placeholder="Custom stage message..."><button id="nudgeSendBtn" type="button" class="act">Send</button></div></div>'
        . '</div></div>'
        . '<div id="aboutModal" class="modalBg hide" role="dialog" aria-modal="true" aria-labelledby="aboutTitle">'
        . '<div class="modalCard">'
        . '<div class="modalHdr"><div class="modalBrand">'
        . '<div class="modalLogo" id="aboutLogo">PS</div>'
        . '<div><div id="aboutTitle" style="font-weight:800;font-size:15px">PresenterSync Web Remote</div>'
        . '<div style="font-size:12px;color:#60a5fa;font-weight:700" id="aboutVer">Version ' (verEsc != "" ? verEsc : "0.0.0") ' &bull; Companion Client</div></div>'
        . '</div><button id="aboutCloseBtn" type="button" class="sm" aria-label="Close About">Close</button></div>'
        . '<div style="font-size:12.5px;line-height:1.5;color:#cbd5e1">'
        . '<b>Created by Saabith Jiffry</b><br>'
        . 'Zero-install browser companion (incl. 1.25x scale) connected to your PresenterSync Primary Host Bridge (:4456). Supports tap-to-mute, OBS scene transitions, PowerPoint navigation with live speaker notes, countdown timer, stage nudges, Clean Disconnect, auto-reconnect + pong watchdog, and Direct OBS :4455 fallback with automatic :4456 bridge re-promotion.'
        . '</div>'
        . '<div class="modalLinks">'
        . '<a class="linkBtn" href="https://github.com/SaabithJiffry/PresenterSync" target="_blank" rel="noopener noreferrer">GitHub Repository</a>'
        . '<a class="linkBtn" href="https://github.com/SaabithJiffry/PresenterSync/releases/latest" target="_blank" rel="noopener noreferrer">Updates &amp; Release Notes</a>'
        . '</div>'
        . '<div id="vaultFooter" class="vaultFooter"><span>PresenterSync Bridge :' portNum '</span><span id="vaultSlotBadge" style="cursor:pointer">CABINET: LOCKED [0 CREDITS]</span></div>'
        . '<div id="vaultDrawerSlot" class="hide"></div>'
        . '</div></div>'
        . '<script>(()=>{ "use strict";'
    html .= 'const qs=id=>document.getElementById(id);'
        . 'const RECONN_DELAYS=[1200,2500,4000,5000];'
        . 'let ws=null,pingT=null,pongWatchT=null,reconnT=null,repromoteT=null,obsWs=null,obsRecT=null;'
        . 'let manualDisconnect=false,hasAuthed=false,reconnAttempts=0,staleCodeRetried=false;'
        . 'let lastCode="",obsCfg=null,obsActive=false,obsStudio=false,obsPreview="",obsPrevProg="";'
        . 'let lastBootId="",lastStateSeq=0,cmdSeq=0;'
        . 'const nextCmdId=()=>devId+"-"+(++cmdSeq);'
        . 'const WEB_APP_VER="' verEsc '";'
        . 'let sceneBtnMap=new Map(),lastSceneKey="";'
        . 'let lastState={isMuted:false,voiceWhileMuted:false,recState:0,recSeconds:0,activeScene:"Scene",scenes:[],slideIndex:0,slideTotal:0,slideTitle:"",slideNotes:"",isStandby:false,timerRemainingSec:600,timerState:"stopped"};'
        . 'let devId=localStorage.getItem("ps_web_device_id");'
        . 'if(!devId){devId="web-"+Math.random().toString(36).slice(2,10);localStorage.setItem("ps_web_device_id",devId);}'
        . 'let tok=localStorage.getItem("ps_web_token")||"";'
    html .= 'function sha256Base64(str){'
        . 'const K=[0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,'
        . '0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,'
        . '0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,'
        . '0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2];'
        . 'const rotr=(x,n)=>(x>>>n)|(x<<(32-n));'
        . 'const b=new TextEncoder().encode(str),bl=b.length*8,pl=((b.length+9+63)&~63);'
        . 'const m=new Uint8Array(pl);m.set(b);m[b.length]=0x80;'
        . 'const dv=new DataView(m.buffer);dv.setUint32(pl-8,Math.floor(bl/0x100000000),false);dv.setUint32(pl-4,bl>>>0,false);'
        . 'let H=[0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19];'
        . 'const w=new Int32Array(64);'
        . 'for(let o=0;o<pl;o+=64){'
        . 'for(let i=0;i<16;i++)w[i]=dv.getInt32(o+i*4,false);'
        . 'for(let i=16;i<64;i++){const s0=rotr(w[i-15],7)^rotr(w[i-15],18)^(w[i-15]>>>3);const s1=rotr(w[i-2],17)^rotr(w[i-2],19)^(w[i-2]>>>10);w[i]=(w[i-16]+s0+w[i-7]+s1)|0;}'
        . 'let[a,b0,c,d,e,f,g,h]=H;'
        . 'for(let i=0;i<64;i++){const S1=rotr(e,6)^rotr(e,11)^rotr(e,25);const ch=(e&f)^(~e&g);const t1=(h+S1+ch+K[i]+w[i])|0;const S0=rotr(a,2)^rotr(a,13)^rotr(a,22);const maj=(a&b0)^(a&c)^(b0&c);const t2=(S0+maj)|0;h=g;g=f;f=e;e=(d+t1)|0;d=c;c=b0;b0=a;a=(t1+t2)|0;}'
        . 'H[0]=(H[0]+a)|0;H[1]=(H[1]+b0)|0;H[2]=(H[2]+c)|0;H[3]=(H[3]+d)|0;H[4]=(H[4]+e)|0;H[5]=(H[5]+f)|0;H[6]=(H[6]+g)|0;H[7]=(H[7]+h)|0;'
        . '}'
        . 'let bin="";for(let i=0;i<8;i++){const v=H[i];bin+=String.fromCharCode((v>>>24)&255,(v>>>16)&255,(v>>>8)&255,v&255);}'
        . 'return btoa(bin);'
        . '}'
    html .= 'function clearWsTimers(){if(pingT){clearInterval(pingT);pingT=null;}if(pongWatchT){clearTimeout(pongWatchT);pongWatchT=null;}}'
        . 'function clearAllTimers(){clearWsTimers();if(reconnT){clearTimeout(reconnT);reconnT=null;}if(repromoteT){clearInterval(repromoteT);repromoteT=null;}if(obsRecT){clearInterval(obsRecT);obsRecT=null;}}'
        . 'function armPongWatch(){if(pongWatchT)clearTimeout(pongWatchT);pongWatchT=setTimeout(()=>{pongWatchT=null;if(ws){try{ws.close();}catch(_){}}},3000);}'
        . 'function clearPongWatch(){if(pongWatchT){clearTimeout(pongWatchT);pongWatchT=null;}}'
        . 'function sendPingWithWatchdog(){if(ws&&ws.readyState===1){sendJson({type:"ping"});armPongWatch();}}'
        . 'function sendJson(o){if(ws&&ws.readyState===1)ws.send(JSON.stringify(o));}'
        . 'function obsSendReq(reqType,reqId,reqData){if(!obsWs||obsWs.readyState!==1)return;const d={requestType:reqType,requestId:reqId};if(reqData)d.requestData=reqData;obsWs.send(JSON.stringify({op:6,d:d}));}'
        . 'function resolveObsNonStudioTarget(){const cur=(lastState.activeScene||"").trim();if(obsPreview&&obsPreview!==cur)return obsPreview;if(obsPrevProg&&obsPrevProg!==cur)return obsPrevProg;const arr=Array.isArray(lastState.scenes)?lastState.scenes:[];if(arr.length>=2){const i=arr.indexOf(cur);const n=i>=0?(i+1)%arr.length:0;let cand=arr[n];if(cand===cur)cand=arr[(n+1)%arr.length];if(cand&&cand!==cur)return cand;}return "";}'
        . 'function sendCmd(t){if(obsActive){if(t==="toggle_mute"){obsSendReq("ToggleInputMute","obsToggleMute",{inputName:(obsCfg&&obsCfg.targetMic)||"Mic/Aux"});}else if(t==="transition_scene"){if(obsStudio){obsSendReq("TriggerStudioModeTransition","obsTrans",null);}else{const tgt=resolveObsNonStudioTarget();if(tgt)obsSendReq("SetCurrentProgramScene","obsTrans",{sceneName:tgt});else{qs("st").textContent="OBS: Need preview or 2+ scenes";setTimeout(()=>{if(obsActive&&obsCfg)qs("st").textContent="DIRECT OBS :"+(obsCfg.port||4455);},2000);}}}return;}sendJson({type:t,cmdId:nextCmdId(),deviceId:devId,source:"web_remote"});}'
        . 'function sendTimer(t,d){if(obsActive)return;sendJson({type:t,cmdId:nextCmdId(),durationSec:d,deviceId:devId,source:"web_remote"});}'
        . 'function sendNudge(m){if(obsActive)return;if(m)sendJson({type:"stage_nudge",cmdId:nextCmdId(),message:m,sender:"Web Remote",deviceId:devId});}'
        . 'function sendCustomNudge(){const inp=qs("nudgeIn");const v=inp.value.trim();if(v){sendNudge(v);inp.value="";}}'
        . 'function fmtTime(s){const neg=s<0;const a=Math.abs(s|0);return(neg?"-":"")+String(Math.floor(a/60)).padStart(2,"0")+":"+String(a%60).padStart(2,"0");}'
    html .= 'function parseObsScenes(arr){'
        . 'if(!Array.isArray(arr)||!arr.length)return[];'
        . 'const out=[];let firstIdx=-1,lastIdx=-1;'
        . 'arr.forEach(it=>{const n=(typeof it==="string"?it:(it&&it.sceneName)||"").trim();if(it&&typeof it==="object"&&typeof it.sceneIndex==="number"){if(firstIdx===-1)firstIdx=it.sceneIndex;lastIdx=it.sceneIndex;}if(n&&!out.includes(n))out.push(n);});'
        . 'return(out.length>1&&firstIdx>=0&&lastIdx>firstIdx)?out.reverse():out;'
        . '}'
        . 'function stopDirectObsFallback(){'
        . 'obsActive=false;obsStudio=false;obsPreview="";obsPrevProg="";'
        . 'if(repromoteT){clearInterval(repromoteT);repromoteT=null;}'
        . 'if(obsRecT){clearInterval(obsRecT);obsRecT=null;}'
        . 'if(obsWs){const old=obsWs;obsWs=null;try{old.close(1000,"repromote");}catch(_){}}'
        . '}'
        . 'function checkRepromoteNow(){'
        . 'if(manualDisconnect||!obsActive)return;'
        . 'fetch("/health",{cache:"no-store"}).then(r=>r.ok?r.json():null).then(j=>{'
        . 'if(j&&j.ok===true&&!manualDisconnect&&obsActive){stopDirectObsFallback();reconnAttempts=0;connectWs(tok?"":lastCode,true);}'
        . '}).catch(()=>{});'
        . '}'
        . 'function startRepromoteProbe(){if(repromoteT)clearInterval(repromoteT);repromoteT=setInterval(checkRepromoteNow,8000);}'
    html .= 'function startDirectObsFallback(){'
        . 'if(manualDisconnect||!obsCfg||obsWs)return;'
        . 'const port=obsCfg.port||4455;'
        . 'const s=new WebSocket("ws://"+location.hostname+":"+port);obsWs=s;'
        . 's.onmessage=ev=>{if(obsWs!==s)return;let msg;try{msg=JSON.parse(ev.data);}catch(_){return;}'
        . 'const op=msg.op,d=msg.d||{};'
        . 'if(op===0){'
        . 'const idD={rpcVersion:1,eventSubscriptions:2047};'
        . 'if(d.authentication&&d.authentication.salt&&d.authentication.challenge){idD.authentication=sha256Base64(sha256Base64((obsCfg.password||"")+d.authentication.salt)+d.authentication.challenge);}'
        . 's.send(JSON.stringify({op:1,d:idD}));'
        . '}else if(op===2){'
        . 'obsActive=true;'
        . 'if(reconnT){clearTimeout(reconnT);reconnT=null;}'
        . 'qs("st").textContent="DIRECT OBS :"+port;qs("st").className="badge warn";'
        . 'qs("authCard").classList.add("hide");qs("deck").classList.remove("hide");qs("discBtn").classList.remove("hide");'
        . 'obsSendReq("GetInputMute","obsInitMute",{inputName:obsCfg.targetMic||"Mic/Aux"});'
        . 'obsSendReq("GetRecordStatus","obsInitRec",null);'
        . 'obsSendReq("GetStreamStatus","obsInitStream",null);'
        . 'obsSendReq("GetSceneList","obsInitScenes",null);'
        . 'obsSendReq("GetStudioModeEnabled","obsInitStudio",null);'
        . 'obsSendReq("GetCurrentPreviewScene","obsInitPreview",null);'
        . 'startRepromoteProbe();'
        . 'if(obsRecT)clearInterval(obsRecT);'
        . 'obsRecT=setInterval(()=>{if(obsActive&&lastState.recState===1)obsSendReq("GetRecordStatus","obsSyncRec",null);},15000);'
        . '}else if(op===5){'
        . 'const et=d.eventType||"",ed=d.eventData||{};'
        . 'if(et==="InputMuteStateChanged"&&ed.inputName===(obsCfg.targetMic||"Mic/Aux")){lastState.isMuted=!!ed.inputMuted;renderState(lastState);}'
        . 'else if(et==="RecordStateChanged"){'
        . 'const os=ed.outputState||"";'
        . 'const st=(os==="OBS_WEBSOCKET_OUTPUT_STARTED"||os==="OBS_WEBSOCKET_OUTPUT_RESUMED")?1:(os==="OBS_WEBSOCKET_OUTPUT_PAUSED"?2:(os==="OBS_WEBSOCKET_OUTPUT_STOPPED"?0:(ed.outputActive?1:0)));'
        . 'lastState.recState=st;if(st===0)lastState.recSeconds=0;else obsSendReq("GetRecordStatus","obsSyncRec",null);renderState(lastState);'
        . '}else if(et==="CurrentProgramSceneChanged"){'
        . 'const sn=(ed.sceneName||ed.currentProgramSceneName||"").trim();if(sn){if(lastState.activeScene&&lastState.activeScene!=="Scene"&&lastState.activeScene!==sn)obsPrevProg=lastState.activeScene;lastState.activeScene=sn;renderState(lastState);}'
        . '}else if(et==="CurrentPreviewSceneChanged"){'
        . 'const pn=(ed.sceneName||ed.currentPreviewSceneName||"").trim();if(pn)obsPreview=pn;'
        . '}else if(et==="SceneListChanged"){'
        . 'const sc=parseObsScenes(ed.scenes);if(sc.length){lastState.scenes=sc;renderState(lastState);}else obsSendReq("GetSceneList","obsInitScenes",null);'
        . '}else if(et==="StudioModeStateChanged"){obsStudio=!!ed.studioModeEnabled;if(obsStudio)obsSendReq("GetCurrentPreviewScene","obsInitPreview",null);}'
        . '}else if(op===7){'
        . 'const rid=d.requestId||"",ok=!(d.requestStatus&&d.requestStatus.result===false),rd=d.responseData;'
        . 'if(rid==="obsInitMute"&&ok&&rd&&typeof rd.inputMuted==="boolean"){lastState.isMuted=rd.inputMuted;renderState(lastState);}'
        . 'else if((rid==="obsInitRec"||rid==="obsSyncRec")&&ok&&rd){lastState.recState=!rd.outputActive?0:(rd.outputPaused?2:1);lastState.recSeconds=rd.outputDuration>=0?Math.floor(rd.outputDuration/1000):0;renderState(lastState);}'
        . 'else if(rid==="obsInitScenes"&&ok&&rd){const sc=parseObsScenes(rd.scenes);if(sc.length)lastState.scenes=sc;if(rd.currentProgramSceneName)lastState.activeScene=rd.currentProgramSceneName;if(rd.currentPreviewSceneName)obsPreview=rd.currentPreviewSceneName;renderState(lastState);}'
        . 'else if(rid==="obsInitPreview"&&ok&&rd){const pn=(rd.currentPreviewSceneName||rd.sceneName||"").trim();if(pn)obsPreview=pn;}'
        . 'else if(rid==="obsInitStudio"&&ok&&rd){obsStudio=!!rd.studioModeEnabled;}'
        . 'else if((rid==="obsTrans"||rid==="obsSwitch")&&!ok){qs("st").textContent="OBS transition failed";obsSendReq("GetCurrentProgramScene","obsInitScenes",null);setTimeout(()=>{if(obsActive&&obsCfg)qs("st").textContent="DIRECT OBS :"+(obsCfg.port||4455);},2200);}'
        . '}'
