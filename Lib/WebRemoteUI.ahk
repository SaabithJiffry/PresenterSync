        . '<script>(()=>{ "use strict";'
    html .= 'const qs=id=>document.getElementById(id);'
        . 'const RECONN_DELAYS=[1200,2500,5000,10000,20000,30000];'
        . 'let ws=null,pingT=null,pongWatchT=null,reconnT=null,repromoteT=null,obsWs=null,obsRecT=null,localClockT=null,optReconcileT=null;'
