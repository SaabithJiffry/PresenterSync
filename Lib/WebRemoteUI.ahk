; ==============================================================================
; Module: WebRemoteUI.ahk
; Description: Self-contained zero-dependency HTML5/CSS3/ES6 companion remote
;              served by HostCompanionBridge on GET / and GET /remote.
; ==============================================================================

#Requires AutoHotkey v2.0

BuildWebRemoteHtml(appVersion := "", activePort := 4456) {
    verEsc := StrReplace(StrReplace(String(appVersion), "<", "&lt;"), ">", "&gt;")
    portNum := IsInteger(activePort) ? Integer(activePort) : 4456
    html := '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">'
        . '<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">'
        . '<title>PresenterSync Web Remote</title><style>'
        . ':root{--bg:#090b10;--card:#131722;--bd:#252c3d;--tx:#f1f5f9;--mu:#94a3b8;--live:#107c10;--muted:#c42b1c;--warn:#f59e0b;--acc:#0067c0}'
        . '*{box-sizing:border-box;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}'
        . 'body{margin:0;background:var(--bg);color:var(--tx);padding:14px;display:flex;justify-content:center}'
        . '.wrap{width:100%;max-width:560px;display:flex;flex-direction:column;gap:12px}'
        . '.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:14px}'
        . '.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}'
        . '.hdr{display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--mu)}'
        . '.pill{width:100%;border:2px solid rgba(255,255,255,.2);border-radius:16px;padding:24px 16px;color:#fff;font-size:26px;font-weight:800;letter-spacing:1px;cursor:pointer;text-align:center}'
        . '.pill.live{background:var(--live)}.pill.muted{background:var(--muted)}.pill.warn{border-color:var(--warn)}'
        . '.sub{font-size:12px;font-weight:600;opacity:.9;margin-top:4px}'
        . 'button{border:1px solid var(--bd);background:#1e2433;color:var(--tx);border-radius:10px;padding:10px 12px;font-size:13px;font-weight:700;cursor:pointer}'
        . 'button.pri{background:var(--acc);border-color:var(--acc);color:#fff;width:100%}'
        . 'button.act{background:var(--acc);border-color:var(--acc);color:#fff}'
        . 'button.brb{background:#d97706;border-color:#d97706;color:#fff}'
        . 'button.grow{flex:1 1 0}'
        . 'input{flex:1;min-width:120px;background:#0c1018;border:1px solid var(--bd);color:var(--tx);border-radius:10px;padding:10px 12px;font-size:14px}'
        . '.notes{background:#0b0e15;border:1px solid var(--bd);border-radius:10px;padding:10px;font-size:13px;line-height:1.45;min-height:64px;max-height:150px;overflow:auto;white-space:pre-wrap;color:#cbd5e1}'
        . '.badge{font-size:11px;font-weight:700;padding:3px 8px;border-radius:999px;background:#1e293b;color:#cbd5e1}'
        . '.badge.rec{background:#dc2626;color:#fff}.badge.warn{background:#d97706;color:#fff}'
        . '.hide{display:none!important}'
        . '</style></head><body><div class="wrap">'
        . '<div class="hdr"><span><b>PresenterSync Web Remote</b>' (verEsc != "" ? " v" verEsc : "") ' (:' portNum ')</span><span id="st" class="badge">Disconnected</span></div>'
        . '<div id="authCard" class="card"><div style="font-weight:700;margin-bottom:8px">Enter 6-Char Session Code</div>'
        . '<div class="row"><input id="codeIn" maxlength="12" placeholder="e.g. ABC-123" autocomplete="off"><button id="connBtn" class="act">Connect</button></div>'
        . '<div id="authErr" style="color:#f87171;font-size:12px;margin-top:8px"></div></div>'
        . '<div id="deck" class="hide" style="display:flex;flex-direction:column;gap:12px">'
        . '<button id="micBtn" class="pill live" onclick="sendCmd(\x27toggle_mute\x27)">MIC LIVE<div id="micSub" class="sub">Tap to mute</div></button>'
        . '<div class="row"><span id="recBadge" class="badge">REC: OFF</span><span id="warnBadge" class="badge warn hide">MIC SIGNAL WHILE MUTED</span></div>'
        . '<button class="pri" onclick="sendCmd(\x27transition_scene\x27)">&#8644; OBS Transition (Preview &#8596; Program) &bull; <span id="scName">Scene</span></button>'
        . '<div class="card"><div class="hdr" style="margin-bottom:8px"><b id="slNum">Slideshow</b><span id="slTitle"></span></div>'
        . '<div class="row" style="margin-bottom:8px"><button class="grow" onclick="sendCmd(\x27ppt_prev\x27)">&#9664; Prev</button><button class="grow" onclick="sendCmd(\x27ppt_next\x27)">Next &#9654;</button><button class="grow" onclick="sendCmd(\x27slide_start\x27)">Start (F5)</button></div>'
        . '<div id="slNotes" class="notes">No speaker notes.</div></div>'
        . '<div class="card"><div class="hdr" style="margin-bottom:8px"><b>Scenes</b></div><div id="scenes" class="row"></div></div>'
        . '<div class="card"><div class="hdr" style="margin-bottom:8px"><b id="tmrTxt">Timer: 10:00 (stopped)</b><button id="brbBtn" onclick="sendCmd(\x27toggle_standby\x27)">BRB</button></div>'
        . '<div class="row"><button class="grow" onclick="sendTimer(\x27timer_start\x27,300)">5m</button><button class="grow" onclick="sendTimer(\x27timer_start\x27,600)">10m</button><button class="grow" onclick="sendTimer(\x27timer_start\x27,900)">15m</button><button class="grow" onclick="sendTimer(\x27timer_pause\x27,0)">Pause</button><button class="grow" onclick="sendTimer(\x27timer_reset\x27,0)">Reset</button></div></div>'
        . '<div class="card"><div class="hdr" style="margin-bottom:8px"><b>Stage Nudge</b></div>'
        . '<div class="row" style="margin-bottom:8px"><button class="grow" onclick="sendNudge(\x272 min left\x27)">2 min left</button><button class="grow" onclick="sendNudge(\x27Wrap up\x27)">Wrap up</button><button class="grow" onclick="sendNudge(\x27Q&amp;A\x27)">Q&amp;A</button></div>'
        . '<div class="row"><input id="nudgeIn" placeholder="Custom stage message..."><button class="act" onclick="sendCustomNudge()">Send</button></div></div>'
        . '</div></div><script>'
        . 'const qs=id=>document.getElementById(id);'
        . 'let ws=null,pingT=null;'
        . 'let devId=localStorage.getItem("ps_web_device_id");'
        . 'if(!devId){devId="web-"+Math.random().toString(36).slice(2,10);localStorage.setItem("ps_web_device_id",devId);}'
        . 'let tok=localStorage.getItem("ps_web_token")||"";'
        . 'function sendJson(o){if(ws&&ws.readyState===1)ws.send(JSON.stringify(o));}'
        . 'function sendCmd(t){sendJson({type:t,deviceId:devId,source:"web_remote"});}'
        . 'function sendTimer(t,d){sendJson({type:t,durationSec:d,deviceId:devId,source:"web_remote"});}'
        . 'function sendNudge(m){if(m)sendJson({type:"stage_nudge",message:m,sender:"Web Remote",deviceId:devId});}'
        . 'function sendCustomNudge(){const v=qs("nudgeIn").value.trim();if(v){sendNudge(v);qs("nudgeIn").value="";}}'
        . 'function fmtTime(s){const neg=s<0;const a=Math.abs(s|0);return(neg?"-":"")+String(Math.floor(a/60)).padStart(2,"0")+":"+String(a%60).padStart(2,"0");}'
        . 'function renderState(m){'
        . 'const btn=qs("micBtn"),sub=qs("micSub"),wb=qs("warnBadge");'
        . 'btn.className="pill "+(m.isMuted?"muted":"live")+(m.isMuted&&m.voiceWhileMuted?" warn":"");'
        . 'btn.firstChild.textContent=m.isMuted?"MIC MUTED":"MIC LIVE";'
        . 'sub.textContent=m.isMuted?"Tap to unmute":"Tap to mute";'
        . 'wb.classList.toggle("hide",!(m.isMuted&&m.voiceWhileMuted));'
        . 'const rb=qs("recBadge");'
        . 'rb.textContent=m.recState===1?"REC "+fmtTime(m.recSeconds||0):(m.recState===2?"PAUSED "+fmtTime(m.recSeconds||0):"REC: OFF");'
        . 'rb.className="badge"+(m.recState===1?" rec":"");'
        . 'qs("scName").textContent=m.activeScene||"Scene";'
        . 'qs("slNum").textContent=(m.slideIndex>0)?("Slide "+m.slideIndex+(m.slideTotal>0?" / "+m.slideTotal:"")):"Slideshow";'
        . 'qs("slTitle").textContent=m.slideTitle||"";'
        . 'qs("slNotes").textContent=m.slideNotes||"No speaker notes.";'
        . 'const brb=qs("brbBtn");brb.textContent=m.isStandby?"BRB ON":"BRB";brb.className=m.isStandby?"brb":"";'
        . 'qs("tmrTxt").textContent="Timer: "+fmtTime(m.timerRemainingSec||0)+" ("+(m.timerState||"stopped")+")";'
        . 'const scBox=qs("scenes");scBox.innerHTML="";'
        . '(m.scenes||[]).forEach(s=>{const b=document.createElement("button");b.textContent=s;if(s===m.activeScene)b.className="act";b.onclick=()=>sendJson({type:"switch_scene",sceneName:s,deviceId:devId,source:"web_remote"});scBox.appendChild(b);});'
        . '}'
        . 'function connectWs(codeVal){'
        . 'if(ws){try{ws.close()}catch(_){}}if(pingT)clearInterval(pingT);'
        . 'qs("authErr").textContent="";qs("st").textContent="Connecting...";'
        . 'const proto=location.protocol==="https:"?"wss://":"ws://";'
        . 'ws=new WebSocket(proto+location.host+"/ws");'
        . 'ws.onopen=()=>sendJson({type:"auth",code:codeVal,token:tok,deviceId:devId,deviceName:"Web Remote",platform:"Web"});'
        . 'ws.onmessage=ev=>{let m;try{m=JSON.parse(ev.data)}catch(_){return;}'
        . 'if(m.type==="auth_ok"){if(m.sessionToken){tok=m.sessionToken;localStorage.setItem("ps_web_token",tok);}qs("st").textContent="Connected";qs("authCard").classList.add("hide");qs("deck").classList.remove("hide");pingT=setInterval(()=>sendJson({type:"ping"}),20000);}'
        . 'else if(m.type==="auth_error"){tok="";localStorage.removeItem("ps_web_token");qs("authErr").textContent=m.error||"Auth failed";qs("authCard").classList.remove("hide");qs("deck").classList.add("hide");qs("st").textContent="Auth Failed";}'
        . 'else if(m.type==="mute_state"||m.type==="sync_resync"){renderState(m);}'
        . 'else if(m.type==="ping"){sendJson({type:"pong",timestamp:Date.now()});}'
        . '};'
        . 'ws.onclose=()=>{if(pingT)clearInterval(pingT);qs("st").textContent="Disconnected";};'
        . '}'
        . 'qs("connBtn").onclick=()=>{const c=qs("codeIn").value.trim().toUpperCase();connectWs(c);};'
        . 'if(tok){connectWs("");}'
        . '</script></body></html>'
    return html
}
