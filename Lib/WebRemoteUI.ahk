        . 'function showToast(msg,durMs){const tb=qs("toastBanner");if(!tb||!msg)return;tb.textContent=msg;tb.classList.remove("hide");if(toastT)clearTimeout(toastT);toastT=setTimeout(()=>{tb.classList.add("hide");toastT=null;},durMs||3200);}'
        . 'function applyRolePolicy(role){const r=(role||window._psRole||"Presenter").trim()||"Presenter";window._psRole=r;const rb=qs("roleBadge");if(rb){rb.textContent=r;rb.className="badge "+(r==="Director"?"ok":(r==="Tally-Only"?"warn":""));rb.classList.remove("hide");}const isDir=(r==="Director"),isTally=(r==="Tally-Only");document.querySelectorAll(".role-dir").forEach(el=>el.classList.toggle("hide",!isDir));document.querySelectorAll(".role-ctl").forEach(el=>{if("disabled" in el)el.disabled=isTally;});renderMicPillVisual();}'
        . 'function updateSceneMarquee(){const txt=qs("scPillTxt"),wrap=txt?txt.parentElement:null,pb=qs("scPrevBadge");if(!txt||!wrap)return;const act=(lastState.activeScene||"Scene").trim()||"Scene";txt.textContent=act;const prev=(lastState.previewSceneName||lastState.previewScene||obsPreview||"").trim();if(pb){if((lastState.studioModeActive||obsStudio)&&prev&&prev!==act){pb.textContent="-> "+prev;pb.classList.remove("hide");}else{pb.classList.add("hide");}}txt.classList.remove("run");txt.style.setProperty("--mq-shift","0px");const ov=txt.scrollWidth-wrap.clientWidth;if(ov>4){txt.style.setProperty("--mq-shift","-"+(ov+8)+"px");txt.classList.add("run");}}'
        . 'let devId=localStorage.getItem("ps_web_device_id");'
