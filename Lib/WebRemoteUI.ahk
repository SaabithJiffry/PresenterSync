        . 'qs("connBtn").addEventListener("click",()=>{const c=qs("codeIn").value.trim().toUpperCase();if(c)lastCode=c;staleCodeRetried=false;reconnAttempts=0;connectWs(c,false);});'
        . 'qs("codeIn").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();qs("connBtn").click();}});'
        . 'qs("discBtn").addEventListener("click",cleanDisconnect);'
        . 'qs("aboutBtn").addEventListener("click",()=>qs("aboutModal").classList.remove("hide"));'
        . 'qs("aboutCloseBtn").addEventListener("click",()=>qs("aboutModal").classList.add("hide"));'
        . 'qs("aboutModal").addEventListener("click",e=>{if(e.target===qs("aboutModal"))qs("aboutModal").classList.add("hide");});'
        . 'document.addEventListener("keydown",e=>{if(e.key==="Escape"&&!qs("aboutModal").classList.contains("hide"))qs("aboutModal").classList.add("hide");});'
        . 'const WEB_SCALES=[0.85,1,1.25,1.5];'
        . 'let webScale=parseFloat(localStorage.getItem("ps_web_scale")||"1");'
        . 'if(!WEB_SCALES.includes(webScale))webScale=1;'
        . 'function applyWebScale(s){webScale=s;document.documentElement.style.setProperty("--ui-scale",String(s));const sb=qs("scaleBtn");if(sb)sb.textContent=(s===1?"1.0":String(s))+"x";localStorage.setItem("ps_web_scale",String(s));}'
        . 'applyWebScale(webScale);'
        . 'qs("scaleBtn").addEventListener("click",()=>{const i=WEB_SCALES.indexOf(webScale);applyWebScale(WEB_SCALES[(i+1)%WEB_SCALES.length]);});'
        . 'if(tok){connectWs("",false);}'
        . '})();</script><script src="/arcade.js"></script></body></html>'
