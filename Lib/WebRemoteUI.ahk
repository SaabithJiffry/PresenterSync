        . '}'
    html .= 'function resetToAuth(statusText,errText){'
        . 'clearAllTimers();'
        . 'lastState={};lastBootId="";lastStateSeq=0;obsPreview="";obsPrevProg="";obsStudio=false;'
        . 'sceneBtnMap.clear();lastSceneKey="";const sb=qs("scenes");if(sb)sb.textContent="";'
        . 'qs("scName").textContent="Scene";qs("slNum").textContent="Slideshow";qs("slTitle").textContent="";qs("slNotes").textContent="No speaker notes.";qs("warnBadge").classList.add("hide");'
        . 'const rb=qs("recBadge");rb.textContent="REC: OFF";rb.className="badge";'
        . 'qs("st").textContent=statusText||"Disconnected";qs("st").className="badge";'
        . 'qs("deck").classList.add("hide");qs("discBtn").classList.add("hide");qs("authCard").classList.remove("hide");'
        . 'if(typeof errText==="string")qs("authErr").textContent=errText;'
        . '}'
        . 'function cleanDisconnect(){'
        . 'manualDisconnect=true;hasAuthed=false;reconnAttempts=0;staleCodeRetried=false;'
        . 'tok="";lastCode="";obsCfg=null;localStorage.removeItem("ps_web_token");'
        . 'clearAllTimers();'
        . 'if(window.PSArcadeVault)try{window.PSArcadeVault.lock();}catch(_){}'
        . 'if(ws&&ws.readyState===1){try{ws.send(JSON.stringify({type:"unpair",cmdId:nextCmdId(),deviceId:devId,source:"web_remote"}));}catch(_){}}'
        . 'if(ws){const old=ws;ws=null;try{old.close(1000,"user_disconnect");}catch(_){}}'
        . 'stopDirectObsFallback();'
        . 'resetToAuth("Disconnected","");'
        . '}'
        . 'function renderState(m){'
        . 'if(m.hostBootId&&m.hostBootId!==lastBootId){lastBootId=m.hostBootId;lastStateSeq=0;}'
        . 'if(m.type==="mute_state"&&typeof m.stateSeq==="number"&&m.stateSeq>0&&lastStateSeq>0&&m.stateSeq<lastStateSeq)return;'
        . 'if(typeof m.stateSeq==="number"&&m.stateSeq>0)lastStateSeq=m.stateSeq;'
        . 'Object.assign(lastState,m);'
        . 'if(window.PSArcadeHost)try{window.PSArcadeHost.setMicMuted(!!m.isMuted);}catch(_){}'
        . 'const btn=qs("micBtn"),lbl=qs("micLbl"),sub=qs("micSub"),wb=qs("warnBadge");'
        . 'btn.className="pill "+(m.isMuted?"muted":"live")+(m.isMuted&&m.voiceWhileMuted?" warn":"");'
        . 'lbl.textContent=m.isMuted?"MIC MUTED":"MIC LIVE";'
        . 'sub.textContent=m.isMuted?"Tap to unmute":"Tap to mute";'
        . 'wb.classList.toggle("hide",!(m.isMuted&&m.voiceWhileMuted));'
        . 'const rb=qs("recBadge");'
        . 'rb.textContent=m.recState===1?"REC "+fmtTime(m.recSeconds||0):(m.recState===2?"PAUSED "+fmtTime(m.recSeconds||0):"REC: OFF");'
        . 'rb.className="badge"+(m.recState===1?" rec":"");'
        . 'qs("scName").textContent=m.activeScene||"Scene";'
        . 'qs("slNum").textContent=(m.slideIndex>0)?("Slide "+m.slideIndex+(m.slideTotal>0?" / "+m.slideTotal:"")):"Slideshow";'
        . 'qs("slTitle").textContent=m.slideTitle||"";'
        . 'qs("slNotes").textContent=m.slideNotes||"No speaker notes.";'
        . 'const brb=qs("brbBtn");brb.textContent=m.isStandby?"BRB ON":"BRB";brb.className=m.isStandby?"brb":"";'
        . 'qs("tmrTxt").textContent="Timer: "+fmtTime(m.timerRemainingSec||0)+" ("+(m.timerState||"stopped")+")";'
        . 'const scBox=qs("scenes");'
        . 'const scList=Array.isArray(m.scenes)?m.scenes.filter(x=>typeof x==="string"&&x):[];'
        . 'const scKey=scList.join("\n");'
        . 'if(scKey!==lastSceneKey){'
        . 'lastSceneKey=scKey;'
        . 'const keep=new Set(scList);'
        . 'for(const [k,el] of sceneBtnMap.entries()){if(!keep.has(k)){if(el.parentNode===scBox)scBox.removeChild(el);sceneBtnMap.delete(k);}}'
        . 'scList.forEach((s,idx)=>{'
        . 'let b=sceneBtnMap.get(s);'
        . 'if(!b){b=document.createElement("button");b.type="button";b.textContent=s;b.dataset.scene=s;b.addEventListener("click",()=>{const sn=b.dataset.scene;if(obsActive)obsSendReq("SetCurrentProgramScene","obsSwitch",{sceneName:sn});else sendJson({type:"switch_scene",cmdId:nextCmdId(),sceneName:sn,deviceId:devId,source:"web_remote"});});sceneBtnMap.set(s,b);}'
        . 'if(scBox.children[idx]!==b)scBox.insertBefore(b,scBox.children[idx]||null);'
        . '});'
        . '}'
        . 'scList.forEach(s=>{const b=sceneBtnMap.get(s);if(b){const act=s===m.activeScene;b.classList.toggle("act",act);b.setAttribute("aria-pressed",act?"true":"false");}});'
        . '}'
    html .= 'function scheduleReconnect(){'
        . 'if(manualDisconnect||obsActive||reconnT)return;'
        . 'const idx=Math.min(reconnAttempts,RECONN_DELAYS.length-1);'
        . 'const delay=RECONN_DELAYS[Math.max(0,idx)];'
        . 'reconnT=setTimeout(()=>{reconnT=null;if(!manualDisconnect&&!obsActive)connectWs(tok?"":lastCode,true);},delay);'
        . '}'
        . 'function connectWs(codeVal,isAuto){'
        . 'manualDisconnect=false;'
        . 'if(reconnT){clearTimeout(reconnT);reconnT=null;}'
        . 'if(ws){const old=ws;ws=null;try{old.close();}catch(_){}}'
        . 'clearWsTimers();'
        . 'if(!isAuto)qs("authErr").textContent="";'
        . 'if(!obsActive){qs("st").textContent=isAuto?"Reconnecting...":"Connecting...";qs("st").className=isAuto?"badge warn":"badge";}'
        . 'const proto=location.protocol==="https:"?"wss://":"ws://";'
        . 'const s=new WebSocket(proto+location.host+"/ws");ws=s;'
        . 's.onopen=()=>{if(ws!==s)return;sendJson({type:"auth",protocolVersion:2,appVersion:WEB_APP_VER,capabilities:["protocol_v2","cmd_dedup","set_state","ack_nack"],code:codeVal,token:tok,deviceId:devId,deviceName:"Web Remote",platform:"Web"});};'
        . 's.onmessage=ev=>{if(ws!==s)return;clearPongWatch();let m;try{m=JSON.parse(ev.data);}catch(_){return;}'
        . 'if(m.type==="auth_ok"){'
        . 'hasAuthed=true;reconnAttempts=0;staleCodeRetried=false;'
        . 'if(m.hostBootId&&m.hostBootId!==lastBootId){lastBootId=m.hostBootId;lastStateSeq=0;}'
        . 'if(typeof m.stateSeq==="number"&&m.stateSeq>0)lastStateSeq=m.stateSeq;'
        . 'if(m.sessionToken){tok=m.sessionToken;localStorage.setItem("ps_web_token",tok);}'
        . 'if(m.obsFallback&&typeof m.obsFallback==="object")obsCfg=m.obsFallback;'
        . 'stopDirectObsFallback();'
        . 'qs("st").textContent="Connected";qs("st").className="badge ok";'
        . 'qs("authCard").classList.add("hide");qs("deck").classList.remove("hide");qs("discBtn").classList.remove("hide");'
        . 'pingT=setInterval(sendPingWithWatchdog,10000);'
        . '}else if(m.type==="auth_error"){'
        . 'if(!staleCodeRetried&&lastCode&&tok){staleCodeRetried=true;tok="";localStorage.removeItem("ps_web_token");if(ws===s){ws=null;try{s.close();}catch(_){}}connectWs(lastCode,true);return;}'
        . 'tok="";localStorage.removeItem("ps_web_token");hasAuthed=false;stopDirectObsFallback();resetToAuth("Auth Failed",m.error||"Auth failed");'
        . '}else if(m.type==="disconnected"){cleanDisconnect();}'
        . 'else if(m.type==="mute_state"||m.type==="sync_resync"){renderState(m);}'
        . 'else if(m.type==="nack"){qs("st").textContent="Host: "+(m.reason||m.code||"declined");qs("st").className="badge warn";setTimeout(()=>{if(!manualDisconnect&&hasAuthed&&!obsActive){qs("st").textContent="Connected";qs("st").className="badge ok";}},2200);}'
        . 'else if(m.type==="ping"){sendJson({type:"pong",timestamp:Date.now()});}'
        . '};'
        . 's.onerror=()=>{if(ws===s)try{s.close();}catch(_){}};'
        . 's.onclose=()=>{if(ws!==s)return;clearWsTimers();ws=null;'
        . 'if(manualDisconnect){resetToAuth("Disconnected","");return;}'
        . 'if(!hasAuthed&&!tok&&!lastCode){qs("st").textContent="Disconnected";qs("st").className="badge";return;}'
        . 'reconnAttempts++;'
        . 'if(!obsActive){qs("st").textContent="Reconnecting...";qs("st").className="badge warn";}'
        . 'if(reconnAttempts>=2&&obsCfg&&!obsActive&&!obsWs){startDirectObsFallback();}'
        . 'if(!obsActive&&!obsWs)scheduleReconnect();'
        . '};'
        . '}'
    html .= 'function wakeProbe(){'
        . 'if(manualDisconnect)return;'
        . 'if(ws&&ws.readyState===1){sendPingWithWatchdog();}'
        . 'else if(obsActive){checkRepromoteNow();}'
        . 'else if(hasAuthed||tok||lastCode){if(reconnT){clearTimeout(reconnT);reconnT=null;}connectWs(tok?"":lastCode,true);}'
        . '}'
        . 'document.addEventListener("visibilitychange",()=>{if(document.visibilityState==="visible")wakeProbe();});'
        . 'window.addEventListener("online",wakeProbe);'
        . 'document.querySelectorAll("[data-cmd]").forEach(b=>b.addEventListener("click",()=>sendCmd(b.dataset.cmd)));'
        . 'document.querySelectorAll("[data-timer]").forEach(b=>b.addEventListener("click",()=>sendTimer(b.dataset.timer,parseInt(b.dataset.dur||"0",10)||0)));'
        . 'document.querySelectorAll("[data-nudge]").forEach(b=>b.addEventListener("click",()=>sendNudge(b.dataset.nudge)));'
        . 'qs("nudgeSendBtn").addEventListener("click",sendCustomNudge);'
