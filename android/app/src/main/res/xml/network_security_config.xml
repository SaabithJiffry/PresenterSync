<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permit ws:// connections to arbitrary local LAN hostnames/IPs (OBS WebSocket & Host Companion Bridge) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Enforce TLS on public WAN endpoints -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">ntfy.sh</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">api.github.com</domain>
    </domain-config>
</network-security-config>
